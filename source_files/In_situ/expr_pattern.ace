Expr_pattern : "Expr2992"
Anatomy_term	"WBbt:0004292"
Anatomy_term	"WBbt:0005813"
Anatomy_term	"WBbt:0005821"
GO_term	"GO:0005634"
GO_term	"GO:0005737"
