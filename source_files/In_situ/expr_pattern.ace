Expr_pattern : "Expr1864"
Anatomy_term	"WBbt:0003675" Certain
Antibody	"Anti-UNC-60 antibody and anti-CeTM antibody."
Antibody
Antibody_info	"WBAntibody00000223"
Antibody_info	"WBAntibody00000472"
GO_term	"GO:0005737"
GO_term	"GO:0005865"
Gene	"WBGene00002978"
Gene	"WBGene00006794"
Life_stage	"WBls:0000003"
Life_stage	"WBls:0000013"
Life_stage	"WBls:0000015"
Life_stage	"WBls:0000021"
