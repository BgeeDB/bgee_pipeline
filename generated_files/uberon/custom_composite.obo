[Term]
id: UBERON:0010856
name: patagium
namespace: uberon
def: "A membranous extension of skin that forms the wing material in animals such as bats. It typically comprises a number of patagial segments, stretching from the side of the body between the forelimb digits and sometimes the hindlimbs." [http://animals.about.com/od/zoologytermsktoz/g/patagium.htm, http://en.wikipedia.org/wiki/Patagium, http://www.brown.edu/Departments/EEB/EML/background/wing_anatomy.htm]
synonym: "flight membrane" RELATED []
synonym: "patagia" RELATED PLURAL []
xref: http://en.wikipedia.org/wiki/Patagium
is_a: UBERON:0000094 ! membrane organ
relationship: part_of UBERON:0000023 ! wing

[Term]
id: UBERON:0010858
name: inter limb-segment region
namespace: uberon
comment: Examples - region between digits in a human embryo; segments of a bat's patagium
synonym: "interlimb" RELATED []
is_a: UBERON:0034929 ! external soft tissue zone

[Term]
id: UBERON:0010861
name: propatagium
namespace: uberon
def: "In bats and pterosaurs, thin web of skin that extends from the shoulder to the wrist anterior to the upper arm and forearm, and is fixed on the neck or skull." [http://palaeos.com/vertebrates/glossary/glossaryPo.html]
is_a: UBERON:0010858 ! inter limb-segment region
relationship: part_of UBERON:0010856 ! patagium
property_value: taxon_notes "In bats: The patagium present from the neck to the first digit" xsd:string {source="http://en.wikipedia.org/wiki/Patagium"}
property_value: taxon_notes "In birds: The triangular fold of skin on leading edge of the wing" xsd:string {source="http://caiquesite.com/glossary.htm"}
property_value: taxon_notes "In pterosaurs: the patagium present from the shoulder to the wrist" xsd:string {source="http://en.wikipedia.org/wiki/Patagium"}

