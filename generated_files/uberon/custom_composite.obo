[Term]
id: UBERON:0018338
name: medial cotyla
namespace: uberon
def: "The medialmost of the cotyla of the lower jaw, for articulation with the cranium." [PHENOSCAPE:alex]
xref: UBERONTEMP:2d15fa5d-566b-4428-83e4-753ae839a965
