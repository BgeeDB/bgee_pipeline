is_a: FBbt:00111026 ! thoracic neuromere (Drosophila)
relationship: part_of UBERON:6000017 ! prothoracic segment

[Term]
id: FBbt:00004055
name: dorsal prothoracic nerve (Drosophila)
def: "A nerve that projects latero-anteriorly from the antero-lateral corner of the thoracico-abdominal ganglion (prothoracic neuromere). It splits into 4 or more branches before innervating various horizontally and vertically oriented tubular muscles." [FlyBase:FBrf0007196]
synonym: "ADN" EXACT [FlyBase:FBrf0007196]
synonym: "anterior dorsal nerve" EXACT [FlyBase:FBrf0007196]
is_a: FBbt:00002063 ! prothoracic nerve (Drosophila)
relationship: part_of UBERON:6003020 ! adult prothoracic segment
relationship: part_of UBERON:6003559 ! adult nervous system

[Term]
id: FBbt:00004056
name: accessory prothoracic nerve (Drosophila)
def: "A nerve that connects to the thoracico-abdominal ganglion (prothoracic neuromere) slightly posterior and ventral to the anterior prothoracic chordotonal organ (FBbt:00007656) and slightly dorsal to the root of the ventral prothoracic nerves. It extends laterally and dorsally almost to the lateral body wall before branching to innervate obliquely placed vertical muscles." [FlyBase:FBrf0007196]
is_a: FBbt:00002063 ! prothoracic nerve (Drosophila)
relationship: part_of UBERON:6003020 ! adult prothoracic segment
relationship: part_of UBERON:6003559 ! adult nervous system

[Term]
id: FBbt:00004057
name: ventral prothoracic nerve (Drosophila)
def: "A nerve that carries fibers from two clusters of microchaetae on the prothoracic coxa (FBbt:00004259) and from motor neuron fibers from lateral anterior muscles. It connects to the thoracico-abdominal ganglion just dorsal to the root of the prothoracic leg nerve and branches about halfway along its length into a motor branch that stays within the body and a sensory branch that projects to the leg." [FlyBase:FBrf0007196]
is_a: FBbt:00002063 ! prothoracic nerve (Drosophila)
relationship: part_of UBERON:6003020 ! adult prothoracic segment
relationship: part_of UBERON:6003559 ! adult nervous system

