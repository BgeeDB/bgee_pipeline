is_a: FBbt:00007241 ! adult head sensillum (Drosophila)
relationship: part_of FBbt:00004531 ! labellum (Drosophila)

[Term]
id: FBbt:00004162
name: labellar taste bristle (Drosophila)
def: "Gustatory bristle on the outer surface of the labellum. Three different types are present: short, intermediate and large bristles. They are innervated by 2 or 4 chemosensory neurons and one mechanosensory neuron." [FlyBase:FBrf0137194]
is_a: FBbt:00004161 ! labellum sensillum (Drosophila)
is_a: FBbt:00005178 ! taste bristle (Drosophila)

[Term]
id: FBbt:00004163
name: labellar taste peg (Drosophila)
def: "Gustatory peg between the cuticular folds of pseudotrachea of the labellum. They measure around 4um in length with a distal shaft of about 2.5um arising from a base that is 1-1.5um high. They are innervated by one chemosensory neuron and one mechanosensory neuron." [FlyBase:FBrf0137194]
is_a: FBbt:00004161 ! labellum sensillum (Drosophila)
is_a: FBbt:00005196 ! peg sensillum (Drosophila)
is_a: UBERON:0003212 ! gustatory organ

[Term]
id: FBbt:00004164
name: pseudotrachea (Drosophila)
def: "Open channel that extends from the dorsal medial region of the labellum, pointing slightly around the outside of each half of the labellum. The pseudotrachea is kept open by narrow, somewhat variably shaped, transverse, sclerotised bands, the ends of which are free from the derm. There are 6 of these per palpus, conducting food to the tip of the labrum." [FlyBase:FBrf0007734, FlyBase:FBrf0033866]
synonym: "pseudotracheal ridge" EXACT [FlyBase:FBrf0127327]
synonym: "pseudotracheal row" EXACT []
relationship: develops_from FBbt:00110713 ! presumptive pseudotrachea (Drosophila)
relationship: part_of FBbt:00004531 ! labellum (Drosophila)

[Term]
id: FBbt:00004165
name: pseudotracheal taste peg (Drosophila)
def: "Taste peg located in rows between and on the lateral sides of the 6 pseudotracheal rows. Each peg sensillum contains one putative chemosensory and one mechanosensory neuron. The lateral rows contain 1-5 taste pegs per row, whereas the remaining rows contain 7-9 pegs." [FlyBase:FBrf0033866, FlyBase:FBrf0137194]
is_a: FBbt:00004163 ! labellar taste peg (Drosophila)

[Term]
id: FBbt:00004166
name: postoccipital sensillum (Drosophila)
def: "Sensillum trichodeum that is located on the dorsal region of a narrow band that borders the occipital foramen of the adult head dorsally. There are two of these." [FlyBase:FBrf0031004, FlyBase:FBrf0044923]
