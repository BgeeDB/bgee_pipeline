xref: UBERONTEMP:6f18830d-27e9-4de6-a1a6-34253907bbfe
is_a: UBERON:0004573 ! systemic artery
relationship: part_of UBERON:0005805 ! dorsal aorta

[Term]
id: UBERON:0018336
name: maxillary shank
namespace: uberon
def: "The triangular shaped posterior fold at the angle of the mouth. From Chakrabarty 2006" [PHENOSCAPE:alex]
xref: UBERONTEMP:d176af29-e3f6-4cfa-a8ee-d26740652bfd
is_a: UBERON:0005913 ! zone of bone organ
relationship: part_of UBERON:0002397 ! maxilla

[Term]
id: UBERON:0018337
name: medial condyle of quadrate
namespace: uberon
def: "The medialmost condyle on the distal region of the quadrate, in contact with the pterygoid." [PHENOSCAPE:alex]
