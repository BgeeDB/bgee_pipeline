is_a: FBbt:00100291 ! glutamatergic neuron (Drosophila)

[Term]
id: FBbt:00111005
name: mushroom body output neuron 7 (Drosophila)
def: "A glutamatergic neuron whose dendrites arborize in alpha lobe slice 1 and its axons project to the superior intermediate and lateral protocerebrum. There are two neurons of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-07" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-alpha1" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)
is_a: FBbt:00100291 ! glutamatergic neuron (Drosophila)

[Term]
id: FBbt:00111006
name: mushroom body output neuron 8 (Drosophila)
def: "A GABAergic neuron whose dendrites arborize in the gamma lobe slice 3 in both hemispheres, and with axonal terminals in the contralateral gamma slice 3. Axonal terminals are also found in the crepine and superior medial protocerebrum. There is one neuron of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-08" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-gamma3" EXACT [FlyBase:FBrf0227179]
is_a: CL:0011005 ! GABAergic interneuron
is_a: FBbt:00007228 ! GABAergic neuron (Drosophila)
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00111007
name: mushroom body output neuron 9 (Drosophila)
def: "A GABAergic neuron whose dendrites arborize in gamma lobe slice 3 in both hemispheres, and in the contralateral beta' lobe slice 1. Axonal terminals are found in the contralateral gamma lobe slice 3, crepine and superior medial protocerebrum. There is one neuron of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-09" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-gamma3beta'1" EXACT [FlyBase:FBrf0227179]
