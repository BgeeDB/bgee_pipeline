synonym: "layer Lop3" EXACT [FlyBase:FBrf0049410]
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003885 ! lobula plate (Drosophila)

[Term]
id: FBbt:00003889
name: lobula plate layer 4 (Drosophila)
def: "Layer of the lobula plate that is the most distant from the second optic chiasm. The terminals of the T neuron T5d, the T neuron T4d, and most of the vertical system neurons terminate in this layer." [FlyBase:FBrf0049410, FlyBase:FBrf0179400]
