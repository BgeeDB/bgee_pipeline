relationship: part_of UBERON:0002342 ! neural crest
property_value: external_definition "A subpopulation of the cephalic neural crest that emerges from the otic level to the anterior limit of somite 4. It migrates to the heart and is essential for the septation of the outflow track[DOI:10.1242/dev.091751]." xsd:string {source="https://doi.org/10.1242/dev.091751"}
property_value: external_ontology_notes "ZFA treats this as a subtype of NC." xsd:string {external_ontology="ZFA"}
created_by: cjm
creation_date: 2009-07-30T07:57:38Z

