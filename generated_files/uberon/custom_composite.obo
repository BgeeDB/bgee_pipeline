is_a: FBbt:00007426 ! ipsilateral tract (Drosophila)

[Term]
id: FBbt:00005107
name: cell body (Drosophila)
def: "The cell body of a neuron, containing the nucleus." [http://flybrain.neurobio.arizona.edu/Flybrain/html/terms/terms.html]
synonym: "soma" RELATED []
is_a: FBbt:00007012 ! cell component (Drosophila)
relationship: part_of CL:0000540 ! neuron

[Term]
id: FBbt:00005110
name: dendrite (Drosophila)
def: "The region of a neuron receiving inputs from other neurons, typically a slender neurite, often branched. In insect neurons, this is often not a clear designation and often presynaptic sites co-extend with postsynaptic ones." [http://flybrain.neurobio.arizona.edu/Flybrain/html/terms/terms.html]
is_a: FBbt:00005113 ! neurite (Drosophila)

[Term]
id: FBbt:00005111
name: dendritic tree (Drosophila)
def: "The arborization of dendrites, defined by the number, position, branching structure, density and stratification of its branches. Dense body. Synaptic ribbon at neuromuscular junction." [http://flybrain.neurobio.arizona.edu/Flybrain/html/terms/terms.html]
synonym: "dendritic arbor" EXACT []
relationship: part_of FBbt:00005110 ! dendrite (Drosophila)

[Term]
id: FBbt:00005112
name: nerve terminal (Drosophila)
def: "The output region of a neuron, generally presynaptic but in insects often also locally postsynaptic. Typically containing large numbers of mitochondria in addition to presynaptic organelles." [http://flybrain.neurobio.arizona.edu/Flybrain/html/terms/terms.html]
synonym: "terminal" RELATED []
is_a: FBbt:00007012 ! cell component (Drosophila)
relationship: part_of CL:0000540 ! neuron

[Term]
id: FBbt:00005113
name: neurite (Drosophila)
def: "One of the processes or extensions of a neuron, axon or dendrite or cell body fiber." [http://flybrain.neurobio.arizona.edu/Flybrain/html/terms/terms.html]
is_a: FBbt:00007012 ! cell component (Drosophila)
relationship: part_of CL:0000540 ! neuron

[Term]
id: FBbt:00005114
name: synapse (Drosophila)
def: "The structural contact that is the site of transmission between neurons, identified by a presynaptic ribbon and synaptic vesicles as the input element and one or (usually) more postsynaptic elements with various specializations (membrane densities, cisternae, etc.)." [http://flybrain.neurobio.arizona.edu/Flybrain/html/terms/terms.html]
is_a: FBbt:00007012 ! cell component (Drosophila)
relationship: part_of CL:0000540 ! neuron

