id: UBERON:0011265
name: carpometacarpal joint of digit 1
namespace: uberon
def: "A carpometacarpal joint that connects to metacarpal 1." [http://en.wikipedia.org/wiki/Carpometacarpal_joint#Thumb]
subset: pheno_slim
