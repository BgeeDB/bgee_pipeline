[Term]
id: FBbt:00007482
name: transverse antennal lobe tract (Drosophila)
def: "Smaller tract that shares a common root with the medial antennal lobe tract (mALT) and connects the antennal lobe to the mushroom body calyx and lateral horn. Fibers can run above, through or below the mushroom body pedunculus, running posterior to the fan-shaped body." [FlyBase:FBrf0205263, FlyBase:FBrf0219793, FlyBase:FBrf0219809]
synonym: "imACT" EXACT [FlyBase:FBrf0205263]
synonym: "inner-middle antenno-cerebral tract" EXACT [FlyBase:FBrf0205263]
synonym: "medial-mediolateral antenno-protocerebral tract" EXACT []
