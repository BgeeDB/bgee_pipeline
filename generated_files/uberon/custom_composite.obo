synonym: "great transverse gyrus of Heschl" EXACT []
synonym: "gyrus temporalis transversus anterior" RELATED LATIN [NeuroNames:134]
synonym: "gyrus temporalis transversus primus" RELATED LATIN [NeuroNames:134]
