[Term]
id: FBbt:00003667
name: lateral ellipsoid body tract (Drosophila)
def: "A transverse tract within the protocerebrum of the adult brain that is connected to the inferior medial/lateral protocerebrum and the central complex." [FBC:VH, ISBN:978-3-540-07343-7]
synonym: "lateral ellipsoid tract" EXACT []
is_a: FBbt:00007426 ! ipsilateral tract (Drosophila)
is_a: UBERON:0007702 ! tract of brain
relationship: part_of UBERON:6007145 ! adult protocerebrum

[Term]
id: FBbt:00003668
name: protocerebral bridge (Drosophila)
def: "A handle bar-shaped synaptic neuropil located just posterior to the fan-shaped body. Its lateral edge ends at the posterior end of the inferior clamp (ICL) near the medial equatorial fascicle (MEF). A row of 16 connected slices (8 on each side of the midline, numbered 1-8 from medial to lateral) that forms a dorso-posteriorly located part of the central complex embedded in the cortex between the calyces of the two mushroom bodies." [FlyBase:FBrf0049409, FlyBase:FBrf0205148, FlyBase:FBrf0213955, FlyBase:FBrf0224194, http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/frontschem3.html, http://flybrain.neurobio.arizona.edu/Flybrain/html/atlas/schematic/sagschem1.html, VFB_vol:00003668]
synonym: "PB" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "pb" EXACT []
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of UBERON:6003632 ! adult central complex

[Term]
id: FBbt:00003669
name: protocerebral bridge slice (Drosophila)
def: "One of the 16 slices that make up the protocerebral bridge, 8 on each side of the midline, numbered 1-8 from medial to lateral." [FlyBase:FBrf0049409, FlyBase:FBrf0205148, FlyBase:FBrf0213955, FlyBase:FBrf0224194]
synonym: "protocerebral bridge glomerulus" EXACT []
is_a: FBbt:00040069 ! synaptic neuropil segment (Drosophila)
relationship: part_of FBbt:00003668 ! protocerebral bridge (Drosophila)

