is_a: UBERON:0004121 ! ectoderm-derived structure
is_a: UBERON:0005291 ! embryonic tissue
relationship: part_of UBERON:0008897 ! fin

[Term]
id: XAO:0000026
name: branchial crest (Xenopus)
def: "The most posterior segments of the population of migratory cells of the cranial neural crest, contributing to the branchial arches 3 and 4. Branchial crest cells migrate in two distinct streams referred to as the anterior and posterior branchial crest." [XAO:CJZ]
is_a: UBERON:0010313 ! neural crest-derived structure
relationship: develops_from UBERON:0003099 ! cranial neural crest
relationship: part_of UBERON:0003099 ! cranial neural crest

[Term]
id: XAO:0000032
name: stomodeal-hypophyseal primordium (Xenopus)
def: "An anterior thickening of the sensorial layer of ectoderm, just above the cement gland. The hypophyseal layer separates from the stomodeal layer at NF stage 29 and 30, and when contacted by a protrusion of the foregut, the stomodeal layer will rupture to form the mouth opening at NF stage 39 and 40." [XAO:curators]
is_a: UBERON:0001048 ! primordium
is_a: UBERON:0004121 ! ectoderm-derived structure
relationship: develops_from XAO:0000320 ! sensorial layer (Xenopus)
relationship: part_of UBERON:0000924 ! ectoderm

[Term]
id: XAO:0000035
name: zygote (Xenopus)
def: "Cell resulting from the fusion of male and female gametes at fertilization." [OMD:zygote]
synonym: "fertilized egg" EXACT []
is_a: CL:0000000 ! cell

[Term]
id: XAO:0000036
name: animal cap (Xenopus)
def: "Ectodermal roof of the blastocoel." [XAO:curators]
synonym: "animal ectoderm" RELATED []
relationship: part_of UBERON:0000924 ! ectoderm

[Term]
id: XAO:0000037
name: animal cap inner layer (Xenopus)
def: "Sensorial layer of blastocoel roof ectoderm." [XAO:curators]
relationship: part_of XAO:0000036 ! animal cap (Xenopus)

[Term]
