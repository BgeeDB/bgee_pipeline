[Term]
id: FBbt:00100506
name: adult brain perineurial glial cell (Drosophila)
def: "Small, oblong-shaped glial cell that is part of the (outer) perineurial sheath layer on the surface of the adult brain. It is located on top of the basal glial cell layer that is composed of the subperineurial glial cells." [FlyBase:FBrf0206543, FlyBase:FBrf0210316]
is_a: FBbt:00007597 ! CNS perineurial sheath glial cell (Drosophila)
is_a: FBbt:00100499 ! adult CNS glial cell (Drosophila)
relationship: part_of UBERON:6003624 ! adult brain

[Term]
id: FBbt:00100507
name: adult brain subperineurial glial cell (Drosophila)
def: "Large, sheet-like glial cell that is a component of the basal glial layer of the adult brain surface. It is located below the apical glial layer that is composed of the perineurial glial cells." [FlyBase:FBrf0206543, FlyBase:FBrf0210316]
synonym: "adult brain basal glial cell" RELATED []
synonym: "adult brain subperineurial glia" RELATED []
synonym: "adult brain subperineurial surface associated glial cell" EXACT [FlyBase:FBrf0206543]
is_a: FBbt:00007605 ! CNS subperineurial glial cell (Drosophila)
is_a: FBbt:00100499 ! adult CNS glial cell (Drosophila)
relationship: part_of UBERON:6003624 ! adult brain

[Term]
id: FBbt:00100509
name: developing satellite glial cell (Drosophila)
def: "." [FlyBase:FBrf0096428, FlyBase:FBrf0206739, FlyBase:FBrf0214261]
is_a: FBbt:00001251 ! embryonic/larval glial cell (Drosophila)
is_a: FBbt:00001256 ! CNS glial cell (Drosophila)
relationship: part_of FBbt:00007676 ! larval optic anlage (Drosophila)

[Term]
id: FBbt:00100510
name: embryonic/larval CNS perineurial glial cell (Drosophila)
def: "Glial cell of the perineurial glial sheath in the embryonic/larval CNS." [FlyBase:FBrf0210316, FlyBase:FBrf0214261]
synonym: "embryonic/larval perineurial glial cell" RELATED []
is_a: FBbt:00001251 ! embryonic/larval glial cell (Drosophila)
is_a: FBbt:00007597 ! CNS perineurial sheath glial cell (Drosophila)
relationship: part_of UBERON:6001919 ! embryonic/larval central nervous system

[Term]
id: FBbt:00100511
name: embryonic/larval PNS perineurial glial cell (Drosophila)
def: "Glial cell of the embryonic/larval peripheral nervous system that ensheathes axons and dendrites. The perineurial layer of glial cell lie on top of the inner, subperineurial glial cells (Banerjee et al., 2006)." [FlyBase:FBrf0191040, FlyBase:FBrf0214261]
is_a: FBbt:00001251 ! embryonic/larval glial cell (Drosophila)
is_a: FBbt:00001320 ! PNS glial cell (Drosophila)
is_a: FBbt:00005153 ! perineurial sheath glial cell (Drosophila)
relationship: part_of FBbt:00005893 ! embryonic/larval peripheral nervous system (Drosophila)

[Term]
id: FBbt:00100512
name: neuroblast DAMv2 (Drosophila)
def: "." [FlyBase:FBrf0194268]
is_a: FBbt:00100739 ! neuroblast DAM (Drosophila)

[Term]
id: FBbt:00100513
name: adult epithelial glial cell (Drosophila)
def: "Epithelial glial cell of the adult." [FlyBase:FBrf0055906, FlyBase:FBrf0134808, FlyBase:FBrf0209968]
is_a: FBbt:00005721 ! epithelial glial cell (Drosophila)
is_a: FBbt:00100504 ! ensheathing neuropil associated glial cell (Drosophila)

[Term]
id: FBbt:00100514
name: embryonic/larval epithelial glial cell (Drosophila)
def: "Epithelial glial cell of the embryo/larva." [FlyBase:FBrf0055906, FlyBase:FBrf0134808, FlyBase:FBrf0209968]
is_a: FBbt:00001303 ! neuropil associated CNS glial cell (Drosophila)
is_a: FBbt:00005721 ! epithelial glial cell (Drosophila)

[Term]
id: FBbt:00100516
name: developing marginal glial cell (Drosophila)
def: "." [FlyBase:FBrf0055906, FlyBase:FBrf0134808]
is_a: FBbt:00001251 ! embryonic/larval glial cell (Drosophila)
is_a: FBbt:00001303 ! neuropil associated CNS glial cell (Drosophila)
relationship: part_of UBERON:6001920 ! insect embryonic/larval brain

[Term]
id: FBbt:00100517
name: adult optic lobe glial cell (Drosophila)
def: "Glial cell of the adult that is associated with the optic lobe." [FlyBase:FBrf0096428, FlyBase:FBrf0210316]
is_a: FBbt:00100499 ! adult CNS glial cell (Drosophila)
relationship: part_of UBERON:0006795 ! arthropod optic lobe

[Term]
id: FBbt:00100518
name: developing distal satellite glial cell (Drosophila)
def: "." [FlyBase:FBrf0055906, FlyBase:FBrf0210316]
is_a: FBbt:00100509 ! developing satellite glial cell (Drosophila)

[Term]
id: FBbt:00100519
name: fenestrated glial cell (Drosophila)
def: "Surface glial cell of the adult optic lobe. The fenestrated glia form a layer overlying the pseudocartridge glial cell layer and contact the basement membrane." [FlyBase:FBrf0210316]
is_a: FBbt:00004210 ! subretinal glial cell (Drosophila)

[Term]
id: FBbt:00100520
name: pseudocartridge glial cell (Drosophila)
def: "Surface glial cell of the adult optic lobe. The pseudocartridge glial cells form a glial layer beneath the distal fenestrated glial cells." [FlyBase:FBrf0210316]
synonym: "subretinal glial cell" RELATED []
is_a: FBbt:00004210 ! subretinal glial cell (Drosophila)

[Term]
id: FBbt:00100521
name: embryonic/larval wrapping glial cell of the eye disc (Drosophila)
def: "Glial cell of the embryonic/larval eye disc that lies above the outgrowing photoreceptor axons and ensheathes bundles of axons extending through the optic stalk (Hummel et al., 2002; Edwards and Hartenstein, 2010). The wrapping glial cells are, in turn, surrounded and wrapped by surface glial cells." [FlyBase:FBrf0145174, FlyBase:FBrf0201162, FlyBase:FBrf0210316]
synonym: "embryonic/larval wrapping glia" RELATED []
synonym: "embryonic/larval wrapping glia of the eye disc" EXACT []
is_a: CL:0000710 ! neurecto-epithelial cell
is_a: FBbt:00001252 ! surface associated glial cell (Drosophila)
is_a: FBbt:00001320 ! PNS glial cell (Drosophila)
relationship: part_of FBbt:00001768 ! eye disc (Drosophila)
relationship: part_of FBbt:00001931 ! embryonic/larval optic stalk (Drosophila)

[Term]
id: FBbt:00100522
name: embryonic/larval optic stalk surface glial cell (Drosophila)
def: "Glial cell associated with the optic stalk that separates the R cells axons from the eye disc and hemolymph. The surface glial cells envelop the wrapping glia (Hummel et al., 2002)." [FlyBase:FBrf0145174, FlyBase:FBrf0201162, FlyBase:FBrf0210316]
is_a: FBbt:00001252 ! surface associated glial cell (Drosophila)
is_a: FBbt:00001320 ! PNS glial cell (Drosophila)
relationship: part_of FBbt:00001931 ! embryonic/larval optic stalk (Drosophila)

[Term]
id: FBbt:00100523
name: distal satellite glial cell (Drosophila)
def: "Satellite glial cell of the adult optic lobe. It lies in a glial layer beneath the pseudocartridge glial cell layer, and above the proximal satellite glial cell layer. It ensheathes cell bodies of monopolar neurons of the lamina cortex." [FlyBase:FBrf0210316]
synonym: "adult distal satellite glial cell" EXACT []
synonym: "rind satellite glial cell" RELATED []
is_a: FBbt:00005723 ! satellite glial cell (Drosophila)
relationship: develops_from FBbt:00100518 ! developing distal satellite glial cell (Drosophila)

[Term]
id: FBbt:00100524
name: adult proximal satellite glial cell (Drosophila)
def: "Satellite glial cell of the adult optic lobe. It is located in a layer between the distal satellite glial layer and the epithelial glia. These glial cells invest the photoreceptor axon bundles and the necks of monopolar neurons." [FlyBase:FBrf0210316]
synonym: "proximal glial cell" RELATED []
is_a: FBbt:00005723 ! satellite glial cell (Drosophila)

[Term]
id: FBbt:00100525
name: adult optic chiasma glial cell (Drosophila)
def: "Glial cell of the adult fly that is located in the optic chiasm (Tix et al., 1997). Members of this group of glial cells are arranged in rows between successive dorsoventral sheets of intercrossing fibers of the outer and inner chiasmata (Edwards and Meinertzhagen, 2010; Tix et al., 1997)." [FlyBase:FBrf0096428, FlyBase:FBrf0210316]
synonym: "adult optic chiasm glial cell" EXACT []
is_a: FBbt:00100517 ! adult optic lobe glial cell (Drosophila)
relationship: part_of FBbt:00003921 ! optic chiasma (Drosophila)

[Term]
id: FBbt:00100526
name: adult outer optic chiasma giant glial cell (Drosophila)
def: "Large glial cell located in the outer optic chiasm of the adult optic lobe. It extends many cytoplasmic processes that enwraps fiber bundles at and near the sites of axonal intersection (Tix et al., 1997)." [FlyBase:FBrf0096428]
synonym: "adult outer optic chiasm giant glial cell" EXACT []
synonym: "adult outer optic chiasm large glial cell" EXACT []
synonym: "giant glial cell" BROAD []
is_a: FBbt:00100517 ! adult optic lobe glial cell (Drosophila)
relationship: part_of FBbt:00005810 ! first optic chiasma (Drosophila)

[Term]
id: FBbt:00100527
name: adult inner optic chiasma giant glial cell (Drosophila)
def: "Large glial cell of the inner optic chiasm of the adult optic lobe. It extends many cytoplasmic processes that enwraps fiber bundles at and near the sites of axonal intersection (Tix et al., 1997)." [FlyBase:FBrf0096428]
synonym: "adult inner optic chiasm giant glial cell" EXACT []
synonym: "adult inner optic chiasm large glial cell" EXACT []
synonym: "giant glial cell" BROAD []
is_a: FBbt:00100517 ! adult optic lobe glial cell (Drosophila)
relationship: part_of FBbt:00003922 ! second optic chiasma (Drosophila)

[Term]
id: FBbt:00100528
name: distal medulla glial cell (Drosophila)
def: "Glial cell located proximal to the marginal glial cells. They elaborate long processes and wrap R cell axons in the medulla, which stop precisely at the base of expanded R8 and R7 growth cones. They also extend processes to the bottom of the lamina furrow (Poeck et al., 2001)." [FlyBase:FBrf0134808]
synonym: "medulla glial cell" RELATED []
synonym: "meg" RELATED [FlyBase:FBrf0134808]
is_a: FBbt:00005738 ! medulla neuropil glial cell (Drosophila)

[Term]
id: FBbt:00100529
name: embryonic/larval carpet glial cell (Drosophila)
def: "Very large glial cell of the embryonic/larval eye disc. There are two per eye disc, each covering approximately half of the differentiated part of the disc, with their nuclei generally being found at the posterior end of the imaginal disc, but always posterior to the differentiating neurons. The glial substrate formed by the carpet glia separates the basal-most migrating glia from the more apical ones (Silies et al., 2007)." [FlyBase:FBrf0201162, FlyBase:FBrf0210316]
is_a: CL:0000710 ! neurecto-epithelial cell
is_a: FBbt:00007598 ! embryonic/larval CNS subperineurial glial cell (Drosophila)
relationship: part_of FBbt:00001768 ! eye disc (Drosophila)

[Term]
id: FBbt:00100530
name: embryonic/larval eye disc marginal glial cell (Drosophila)
def: "Glial cell located at the margins of the eye disc, showing an elongated, clapboard-like shape (Silies et al., 2007; Edwards and Meinertzhagen, 2010)." [FlyBase:FBrf0201162, FlyBase:FBrf0210316]
is_a: CL:0000710 ! neurecto-epithelial cell
is_a: FBbt:00001251 ! embryonic/larval glial cell (Drosophila)
is_a: FBbt:00001252 ! surface associated glial cell (Drosophila)
relationship: part_of FBbt:00001768 ! eye disc (Drosophila)

[Term]
id: FBbt:00100531
name: antennal lobe glomerulus DC4 (Drosophila)
def: "Dorsal glomerulus of the adult antennal lobe. It lies ventral to glomerulus DM3 and posterior to DC2 and DC1, and is innervated by coeloconic olfactory receptor neurons (Couto et al., 2005)." [FlyBase:FBrf0107836, FlyBase:FBrf0187305, FlyBase:FBrf0212455, FlyBase:FBrf0219809]
synonym: "antennal glomerulus DC4" EXACT []
is_a: FBbt:00067500 ! adult antennal lobe glomerulus (Drosophila)

[Term]
id: FBbt:00100532
name: type I neuroblast (Drosophila)
def: "Neuroblast that asymmetrically divides to produce a large daughter neuroblast cell and a smaller GMC cell that generates two daughter neurons." [FlyBase:FBrf0207387]
is_a: CL:0000031 ! neuroblast

[Term]
id: FBbt:00100533
name: type II neuroblast (Drosophila)
def: "Neuroblast that asymmetrically divides to produce a large daughter neuroblast cell and a smaller secondary neuroblast (also called a transit-amplifying GMC) that can generate up to ten daughter neurons or glial cells (Boone and Doe, 2008, Viktorin et al., 2011)." [FlyBase:FBrf0204899, FlyBase:FBrf0207387, FlyBase:FBrf0209927, FlyBase:FBrf0214289, FlyBase:FBrf0214495]
synonym: "TA neuroblast" RELATED []
synonym: "transiently amplifying neuroblast" EXACT []
synonym: "transit amplifying neuroblast" EXACT []
is_a: CL:0000031 ! neuroblast

[Term]
id: FBbt:00100534
name: embryonic/larval dMP2 ILP7 neuron (Drosophila)
def: "A dMP2 neuron that expresses ILP7. All dMP2 neurons that survive in the larva (those in A6-9) are of this type. There are two per segment. All project to the hindgut. These projections have ILP7 positive swellings associated with circular visceral muscle. Their terminals are also sites of ILP7 localization." [FlyBase:FBrf0204880]
synonym: "dMP2 ILP7 expressing neuron" EXACT []
is_a: CL:0000381 ! neurosecretory neuron
is_a: FBbt:00001987 ! abdominal neuron (Drosophila)
relationship: part_of UBERON:6000171 ! insect embryonic abdomen
relationship: part_of UBERON:6001746 ! larval abdomen

[Term]
id: FBbt:00100535
name: dMP2 ILP7 neuron of abdominal segment 6 (Drosophila)
def: "dMP2 neuron located in embryonic/larval abdominal segment 6, and which expresses ILP7." [FlyBase:FBrf0204880]
is_a: FBbt:00100534 ! embryonic/larval dMP2 ILP7 neuron (Drosophila)
relationship: part_of FBbt:00000027 ! abdominal segment 6 (Drosophila)

[Term]
id: FBbt:00100536
name: dMP2 ILP7 neuron of abdominal segment 7 (Drosophila)
def: "dMP2 neuron located in embryonic/larval abdominal segment 7, and which expresses ILP7." [FlyBase:FBrf0204880]
is_a: FBbt:00100534 ! embryonic/larval dMP2 ILP7 neuron (Drosophila)
relationship: part_of FBbt:00000028 ! abdominal segment 7 (Drosophila)

[Term]
id: FBbt:00100537
name: dMP2 ILP7 neuron of abdominal segment 8 (Drosophila)
def: "dMP2 neuron located in embryonic/larval abdominal segment 8, and which expresses ILP7." [FlyBase:FBrf0204880]
is_a: FBbt:00001995 ! A8 neuron (Drosophila)
is_a: FBbt:00100534 ! embryonic/larval dMP2 ILP7 neuron (Drosophila)

[Term]
id: FBbt:00100538
name: dMP2 ILP7 neuron of abdominal segment 9 (Drosophila)
def: "dMP2 neuron located in embryonic/larval abdominal segment 9, and which expresses ILP7." [FlyBase:FBrf0204880]
is_a: FBbt:00100534 ! embryonic/larval dMP2 ILP7 neuron (Drosophila)
relationship: part_of UBERON:6000030 ! abdominal segment 9

[Term]
id: FBbt:00100539
name: adult dMP2 ILP7 neuron (Drosophila)
def: "An adult dMP2 neuron that expresses ILP7. There are two per abdominal segment, all projecting to the hindgut. These projections have ILP7 positive swellings and connect to the anterior intestines and the rectum. Their terminals are also sites of ILP7 localization (Miguel-Aliaga et al., 2008)." [FlyBase:FBrf0204880]
is_a: CL:0000381 ! neurosecretory neuron

