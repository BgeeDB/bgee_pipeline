namespace: uberon
def: "." [PHENOSCAPE:alex]
xref: UBERONTEMP:5b20659c-8d12-4809-9f5a-ad4bb047fc65
is_a: UBERON:0000064 ! organ part
relationship: part_of UBERON:0018348 ! petrosal bone

