id: FBbt:00100329
name: frontal nerve (Drosophila)
synonym: "FrN" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:0001021 ! nerve

[Term]
id: FBbt:00100330
name: adult frontal nerve (Drosophila)
def: "The adult frontal nerve contains a variety of fibers, largely from interneurons, and connects the tritocerebrum and the frontal ganglion (an unpaired structure on the anterior side of the esophagus)." [FlyBase:FBrf0224194]
synonym: "FrN" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "frontal nerve" EXACT []
is_a: FBbt:00100329 ! frontal nerve (Drosophila)
is_a: UBERON:0011779 ! nerve of head region
relationship: part_of UBERON:6003007 ! insect adult head

[Term]
id: FBbt:00100332
name: adult recurrent nerve (Drosophila)
def: "The adult recurrent nerve runs from the frontal ganglion posteriorly along the esophagus and foregut. It contains fibers of the enteric nervous system." [FlyBase:FBrf0080339, FlyBase:FBrf0224194]
synonym: "RcN" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "recurrent nerve" RELATED []
is_a: UBERON:0001021 ! nerve

[Term]
id: FBbt:00100333
name: labial nerve (Drosophila)
synonym: "LbN" EXACT []
