relationship: part_of UBERON:0002241 ! chondrocranium
property_value: axiom_lost_from_external_ontology "relationship loss: part_of braincase and otic capsule skeleton (AAO:0000052)[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000040", ontology="AAO"}
property_value: external_definition "An endochondral bone that is located ventral to the pterosphenoid and dorsal to the parasphenoid. Basisphenoid is a median bone that is usually Y-shaped.[TAO]" xsd:string {date_retrieved="2012-08-14", external_class="TAO:0000169", ontology="TAO", source="TAO:wd"}
