[Term]
id: CL:1001435
name: periglomerular cell
namespace: cl
def: "The small neuron in the glomerular layer of the olfactory bulb whose dendrites arborize within a glomerulus, where it receives synaptic input from olfactory receptor cell axon terminals, and also engages in dendrodendritic interactions with mitral and tufted cell dendrites; uses both GABA and dopamine as a neurotransmitter." []
synonym: "glomerular layer cell" EXACT []
synonym: "olfactory bulb (accessory) glomerular layer cell" EXACT []
synonym: "olfactory bulb glomerular layer cell" EXACT []
synonym: "olfactory bulb glomerularal cell" EXACT []
