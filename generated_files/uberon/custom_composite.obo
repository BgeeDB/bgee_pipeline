id: FBbt:00005297
name: cycle 5 embryo (Drosophila)
is_a: FBbt:00005293 ! stage 2 embryo (Drosophila)

[Term]
id: FBbt:00005298
name: cycle 6 embryo (Drosophila)
is_a: FBbt:00005293 ! stage 2 embryo (Drosophila)

[Term]
id: FBbt:00005299
