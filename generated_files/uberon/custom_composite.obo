synonym: "M-ISNG" EXACT [FlyBase:FBrf0082171]
synonym: "SBC" EXACT [FlyBase:FBrf0064795]
synonym: "segment boundary cell" EXACT [FlyBase:FBrf0064795]
is_a: FBbt:00001304 ! intersegmental nerve root glial cell (Drosophila)

[Term]
id: FBbt:00001306
name: lateral intersegmental nerve root glial cell (Drosophila)
def: "Intersegmental nerve root glia that is located near the exit point of the nerve root." [FlyBase:FBrf0054242, FlyBase:FBrf0082171, FlyBase:FBrf0214261]
