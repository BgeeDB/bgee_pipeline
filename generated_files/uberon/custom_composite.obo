[Term]
id: FBbt:00057000
name: early-mid elongation-stage spermatid (Drosophila)
def: "An elongating spermatid, 200-500 micrometers in length and in which nuclear shaping has begun. The two parts of the mitochondrial derivative become unequal in size." [FlyBase:FBrf0064778]
is_a: FBbt:00005310 ! elongation stage spermatid (Drosophila)
is_a: UBERON:0004120 ! mesoderm-derived structure
relationship: develops_from FBbt:00057174 ! comet stage spermatid (Drosophila)

[Term]
id: FBbt:00057002
name: late elongation-stage spermatid (Drosophila)
def: "A nearly fully elongated spermatid bigger than 1.2 mm length, with a needle-shaped nucleus." [FlyBase:FBrf0064778]
is_a: FBbt:00005310 ! elongation stage spermatid (Drosophila)
is_a: UBERON:0004120 ! mesoderm-derived structure
relationship: develops_from FBbt:00057003 ! mid-late elongation-stage spermatid (Drosophila)

[Term]
id: FBbt:00057003
name: mid-late elongation-stage spermatid (Drosophila)
def: "An elongating spermatid 0.8-1.2 mm in length, with a nucleus resembling a canoe." [FlyBase:FBrf0064778]
is_a: FBbt:00005310 ! elongation stage spermatid (Drosophila)
is_a: UBERON:0004120 ! mesoderm-derived structure
relationship: develops_from FBbt:00057000 ! early-mid elongation-stage spermatid (Drosophila)

