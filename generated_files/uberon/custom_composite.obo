[Term]
id: CL:0002073
name: transitional myocyte
namespace: cell
def: "Specialized cardiac myocyte which is in the internodal tract and atrioventricular node. The cell is more slender than ordinary atrial myocytes and has more myofibrils than nodal myocytes." []
