[Term]
id: FBbt:00001446
name: embryonic/larval neuron (Drosophila)
def: "A neuron that is part of the embryonic/larval nervous system." [FlyBase:FBrf0090460, FlyBase:FBrf0098344]
synonym: "embryonic neuron" EXACT []
synonym: "larval neuron" EXACT []
is_a: CL:0000540 ! neuron
relationship: part_of UBERON:6001911 ! insect embryonic/larval nervous system

[Term]
id: FBbt:00001447
name: aCC neuron (Drosophila)
def: "Motor neuron born from the first GMC to bud from neuroblast NB1-1. It has a large round cell body that sits at the dorsal surface of the CNS, in the next anterior segment which it innervates, just posterior to the posterior commissure and longitudinal connective." [FlyBase:FBrf0064795, FlyBase:FBrf0099344, http://www.neuro.uoregon.edu/doelab/lineages/texts/11%20description.html]
synonym: "1-1a1" RELATED []
synonym: "anterior corner cell" RELATED []
is_a: FBbt:00011534 ! 1-1M (Drosophila)
relationship: develops_from FBbt:00001434 ! ganglion mother cell GMC1-1a (Drosophila)

[Term]
id: FBbt:00001448
name: pCC neuron (Drosophila)
def: "The pCC is an interneuron whose large, round cell body is located just posterior, medial and ventral to the MN-DA1 (aCC) motor neuron (FBbt:00001447). It extends a neurite anteriorly along one of the longitudinal fascicles (Doe et al., 1988)." [FlyBase:FBrf0048756, FlyBase:FBrf0064795, http://www.neuro.uoregon.edu/doelab/lineages/texts/11%20description.html]
synonym: "1-1a2" RELATED []
synonym: "posterior corner cell" RELATED []
synonym: "sibling of aCC" EXACT [FlyBase:FBrf0086924]
is_a: CL:0000099 ! interneuron
is_a: FBbt:00001446 ! embryonic/larval neuron (Drosophila)
is_a: UBERON:0004121 ! ectoderm-derived structure
relationship: develops_from FBbt:00001371 ! neuroblast NB1-1 (Drosophila)

[Term]
id: FBbt:00001449
name: fpCC neuron (Drosophila)
def: "Interneuron that develops from neuroblast NB7-1. It projects anteriorly in a medial fascicle of the ipsilateral connective, then across the anterior commissure and then anteriorly in the contralateral connective. Its cell body is the most medial cell of this lineage clone." [FlyBase:FBrf0105282, FlyBase:FBrf0112030]
synonym: "FP cell" EXACT []
synonym: "fpCC" EXACT [FlyBase:FBrf0112030]
synonym: "friend of pCC cell" EXACT []
is_a: CL:0000099 ! interneuron
is_a: FBbt:00001446 ! embryonic/larval neuron (Drosophila)
is_a: UBERON:0004121 ! ectoderm-derived structure
relationship: develops_from FBbt:00001380 ! neuroblast NB7-1 (Drosophila)

[Term]
id: FBbt:00001450
name: segmental nerve pioneer neuron (Drosophila)
def: "Neuron that, along with one or two other neurons, pioneers the segmental nerve. The cell bodies of this cluster of 2-3 neurons are located posterior and slightly more lateral than the aCC and pCC neurons." [FlyBase:FBrf0105282]
synonym: "SN-pioneer" EXACT [FlyBase:FBrf0105282]
synonym: "SNp" RELATED []
is_a: CL:0000116 ! pioneer neuron
relationship: part_of UBERON:6001055 ! presumptive embryonic/larval nervous system

[Term]
id: FBbt:00001451
name: RP neuron (Drosophila)
def: "Neuron of the embryonic/larval CNS. The RP neurons are mainly motor neurons. An RP motor neuron innervates each of muscles 2, 3, 6, 7, 11, 12, 13, 14, 19, 20, 28 and 30. RP2sib is the only RP neuron not to be a motor neuron." [FlyBase:FBrf0047653, FlyBase:FBrf0064795, FlyBase:FBrf0112030]
is_a: FBbt:00001446 ! embryonic/larval neuron (Drosophila)

[Term]
id: FBbt:00001452
name: RP1 motor neuron (Drosophila)
def: "A motor neuron that develops from neuroblast NB3-1 and whose large cell body is located between the anterior and posterior commissures at the dorsal surface of the CNS." [FlyBase:FBrf0047653, FlyBase:FBrf0053781, FlyBase:FBrf0099344, http://www.neuro.uoregon.edu/doelab/lineages/texts/31%20description.html]
synonym: "RP1 neuron" EXACT [FlyBase:FBrf0112030]
is_a: FBbt:00001451 ! RP neuron (Drosophila)
is_a: FBbt:00007678 ! 3-1M (Drosophila)

[Term]
id: FBbt:00001453
name: RP2 motor neuron (Drosophila)
def: "Motor neuron whose large cell body is located in the next anterior segment which it innervates, at the extreme dorsal surface of the CNS above the junction of the anterior commissure and the longitudinal connective." [FlyBase:FBrf0099344, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/texts/42%20description.html]
synonym: "4-2a1" RELATED []
synonym: "RP2" EXACT [FlyBase:FBrf0064795]
synonym: "RP2 neuron" EXACT [FlyBase:FBrf0064795]
is_a: FBbt:00001451 ! RP neuron (Drosophila)
is_a: FBbt:00007675 ! embryonic/larval motor neuron (Drosophila)
is_a: UBERON:0004121 ! ectoderm-derived structure
relationship: develops_from FBbt:00001438 ! ganglion mother cell GMC4-2a (Drosophila)

[Term]
id: FBbt:00001454
name: RP2sib neuron (Drosophila)
def: "Neuron developing from GMC4-2a, the first born ganglion mother cell differentiating from neuroblast NB4-2 (Bhat et al., 1995). Its ultimate fate is unknown, but can be distinguished from its sibling motor neuron, RP2 (FBbt:00001453), by lower expression of markers such as the membrane protein recognized by monoclonal antibody 22C10, eve (FBgn0000606), or ftz (FBgn0001077)." [FlyBase:FBrf0055900, FlyBase:FBrf0081448]
synonym: "4-2a2" EXACT [FlyBase:FBrf0055900]
synonym: "RP2/sib" EXACT [FlyBase:FBrf0081448]
synonym: "sib" RELATED [FlyBase:FBrf0081448]
is_a: FBbt:00001451 ! RP neuron (Drosophila)
is_a: UBERON:0004121 ! ectoderm-derived structure
relationship: develops_from FBbt:00001438 ! ganglion mother cell GMC4-2a (Drosophila)

[Term]
id: FBbt:00001455
name: RP3 motor neuron (Drosophila)
def: "RP motor neuron of the 3-1 lineage whose cell body is located ventral and lateral to RP1 and RP4, and which projects an axon contralaterally." [FlyBase:FBrf0053781, FlyBase:FBrf0099344, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/texts/31%20description.html]
synonym: "RP3 neuron" RELATED [FlyBase:FBrf0112030]
is_a: FBbt:00001451 ! RP neuron (Drosophila)
is_a: FBbt:00007678 ! 3-1M (Drosophila)

[Term]
id: FBbt:00001456
name: RP4 motor neuron (Drosophila)
def: "Motor neuron of the 3-1 lineage with a large cell body located adjacent to that of RP1." [FlyBase:FBrf0053781, FlyBase:FBrf0099344, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/texts/31%20description.html]
synonym: "RP4 neuron" RELATED [FlyBase:FBrf0112030]
is_a: FBbt:00001451 ! RP neuron (Drosophila)
is_a: FBbt:00007678 ! 3-1M (Drosophila)

[Term]
id: FBbt:00001457
name: RP5 motor neuron (Drosophila)
def: "An RP motor neuron from neuroblast NB3-1 lineage. It is the most anteriorly located of the RP neurons." [FlyBase:FBrf0053781, FlyBase:FBrf0099344, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/texts/31%20description.html]
synonym: "MNSNb/d-Is" EXACT [FlyBase:FBrf0132289]
synonym: "RP5 neuron" RELATED [FlyBase:FBrf0112030]
is_a: FBbt:00001451 ! RP neuron (Drosophila)
is_a: FBbt:00007678 ! 3-1M (Drosophila)

