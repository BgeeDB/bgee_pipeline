[Term]
id: UBERON:0008840
name: plantar pad
namespace: uberon
def: "An autopod pad that is in the metatarsal region" [https://orcid.org/0000-0002-6601-2165]
synonym: "fore foot pad" RELATED []
synonym: "metatarsal foot pad" RELATED []
