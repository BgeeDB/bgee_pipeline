[Term]
id: UBERON:0001502
name: interosseous muscle of manus
namespace: uberon
def: "Any of the interosseous muscles of the manus (hand). This includes the dorsal and plantar interossei" [http://orcid.org/0000-0002-6601-2165]
subset: pheno_slim
