xref: http://linkedlifedata.com/resource/umls/id/C1521985
xref: http://www.snomedbrowser.com/Codes/Details/244807009
xref: NCIT:C33510
xref: Salpingopharyngeus:muscle
xref: UMLS:C1521985 {source="ncithesaurus:Salpingopharyngeus"}
