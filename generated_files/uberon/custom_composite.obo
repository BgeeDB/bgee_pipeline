[Term]
id: FBbt:00111021
name: dopaminergic PAM neuron 9 (Drosophila)
def: "A dopaminergic neuron of the PAM cluster that projects to the beta lobe slice 1 and pedunculus. There are between 1-3 neurons of this type per hemisphere." [FlyBase:FBrf0227179]
synonym: "PAM-09" EXACT [FlyBase:FBrf0227179]
synonym: "PAM-beta1ped" EXACT [FlyBase:FBrf0227179]
