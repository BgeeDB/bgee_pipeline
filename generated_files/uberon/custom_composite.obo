[Term]
id: UBERON:0003547
name: brain meninx
namespace: uberon
def: "A meninx that is part of a brain [Automatically generated definition]." [OBOL:automatic]
subset: organ_slim
subset: pheno_slim
synonym: "brain meninges" EXACT [OBOL:automatic]
synonym: "meninges of brain" EXACT [OBOL:automatic]
