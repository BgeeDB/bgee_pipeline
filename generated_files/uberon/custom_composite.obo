relationship: part_of UBERON:0000934 ! ventral nerve cord

[Term]
id: FBbt:00001303
name: neuropil associated CNS glial cell (Drosophila)
def: "Glial cell associated with neuropil regions, including regions of synaptic neuropil, axons, tracts, commissures and nerve roots. There are between 90-100 neuropil associated glial cells in a single late larval brain hemisphere (Hartenstein, 2011)." [FlyBase:FBrf0082171, FlyBase:FBrf0214261]
synonym: "neuropil associated glial cell" EXACT [FlyBase:FBrf0214261]
synonym: "neuropil-associated CNS glial cell" EXACT []
synonym: "neuropil-associated glial cell" EXACT [FlyBase:FBrf0214261]
is_a: FBbt:00001256 ! CNS glial cell (Drosophila)
relationship: part_of FBbt:00007117 ! neuropil glial sheath (Drosophila)

[Term]
id: FBbt:00001304
name: intersegmental nerve root glial cell (Drosophila)
def: "Nerve root glial cell associated with the intersegmental nerve root." [FlyBase:FBrf0082171, FlyBase:FBrf0214261]
synonym: "ISNG" EXACT [FlyBase:FBrf0082171]
is_a: FBbt:00001251 ! embryonic/larval glial cell (Drosophila)
is_a: FBbt:00100495 ! nerve root glial cell (Drosophila)
relationship: develops_from FBbt:00001404 ! neuroblast NB1-3 (Drosophila)
relationship: part_of FBbt:00007604 ! intersegmental nerve root (Drosophila)

[Term]
id: FBbt:00001305
name: medial intersegmental nerve root glial cell (Drosophila)
def: "Intersegmental nerve glial cell that is located at the medial end of the anterior branch of the intersegmental nerve root, above the lateral neuropil. It contacts both the perineurium and the cortex/neuropil interface and its position is slightly lateral to the B-SPG. It sends a process laterally along the nerve root, showing a characteristic triangular morphology." [FlyBase:FBrf0054242, FlyBase:FBrf0064795, FlyBase:FBrf0082171, FlyBase:FBrf0214261]
synonym: "intersegmental glial cell 1" EXACT [FlyBase:FBrf0054242]
