synonym: "transverse of haustellum" RELATED []
is_a: FBbt:00003267 ! haustellum muscle (Drosophila)

[Term]
id: FBbt:00003271
name: cibarial muscle (Drosophila)
def: "Muscle involved in the movement of the cibarium." [FlyBase:FBrf0007735, ISBN:978-1-58706-259-9]
is_a: FBbt:00003260 ! skeletal muscle of head (Drosophila)
relationship: part_of FBbt:00004526 ! adult cibarium (Drosophila)

[Term]
id: FBbt:00003272
name: cibarial muscle 9 (Drosophila)
def: "Muscle of the cibarium that, together with cibarial muscle 10, rotates the pharynx up into the head. It is a longer muscle than cibarial muscle 10, and extends in a dorsomedial-anteriolateral orientation, originating on the cranial wall just below and anterior to the eye. It is required for the proboscis extension reflex." [FlyBase:FBrf0007735, ISBN:978-1-58706-259-9]
synonym: "lateral pharyngeal muscle" EXACT [FlyBase:FBrf0007734]
synonym: "retractor of fulcrum" EXACT [FlyBase:FBrf0007735]
synonym: "rostral protractor" EXACT [FlyBase:FBrf0044141]
is_a: FBbt:00003271 ! cibarial muscle (Drosophila)

[Term]
id: FBbt:00003273
name: cibarial muscle 10 (Drosophila)
def: "Muscle of the cibarium that, together with cibarial muscle 9, rotates the pharynx up into the head. It is a shorter muscle than cibarial muscle 9, extending in a dorso-posterior orientation." [FlyBase:FBrf0007735, ISBN:978-1-58706-259-9]
synonym: "median pharyngeal muscle" EXACT [FlyBase:FBrf0007734]
is_a: FBbt:00003271 ! cibarial muscle (Drosophila)

[Term]
id: FBbt:00003274
name: cibarial dilator muscle (Drosophila)
def: "Muscle involved in the dilation of the cibarium." [FlyBase:FBrf0007735, ISBN:978-1-58706-259-9]
is_a: FBbt:00003271 ! cibarial muscle (Drosophila)

[Term]
id: FBbt:00003275
name: cibarial dilator muscle 11 (Drosophila)
def: "Cibarial dilator muscle having its origin in the clypeus and connects to the median apodemal carina at the upper portion of the anterior cibarial plate (Miller, 1950). It functions together with cibarial muscle 12." [FlyBase:FBrf0007735, ISBN:978-1-58706-259-9]
synonym: "dilator of pharynx" EXACT [FlyBase:FBrf0007735]
synonym: "pharyngeal muscle" EXACT [FlyBase:FBrf0007734]
is_a: FBbt:00003274 ! cibarial dilator muscle (Drosophila)

[Term]
id: FBbt:00003276
name: cibarial dilator muscle 12 (Drosophila)
def: "Cibarial dilator muscle having its origin in the clypeus and connects to the expanded ventral portion of the anterior cibarial plate (Miller, 1950). It functions together with cibarial muscle 11." [FlyBase:FBrf0007735, ISBN:978-1-58706-259-9]
synonym: "cibarial muscle" EXACT [FlyBase:FBrf0007734]
synonym: "dilator of pharynx" EXACT [FlyBase:FBrf0007735]
is_a: FBbt:00003274 ! cibarial dilator muscle (Drosophila)

[Term]
