[Term]
id: FBbt:00003650
name: ring neuron R1 (Drosophila)
def: "Ring neuron R that arborizes in an inner ring of the ellipsoid body, close to the ellipsoid body canal. Arborizing branches originate in the ellipsoid body canal and extend outwards." [FlyBase:FBrf0049409, FlyBase:FBrf0111476]
synonym: "ebR1" EXACT [FlyBrain_NDB:10260]
synonym: "R1 neuron" EXACT [FlyBase:FBrf0111476]
