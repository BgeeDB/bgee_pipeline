is_a: CL:0002369 ! fungal spore

[Term]
id: CL:0000606
name: macroconidium
namespace: cell
def: "The larger of two types of asexual spores formed by some fungi; usually round or oblong." []
xref: FAO:0000038
is_a: CL:0000599 ! conidium

[Term]
id: CL:0000607
name: ascospore
namespace: cell
