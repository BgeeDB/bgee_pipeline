property_value: external_definition "Network of reticular fibres (fine collagen) that form a soft skeleton to support the lymphoid organs (lymph nodes, bone marrow, and spleen).[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000542", ontology="AAO", source="AAO:LAP"}
