ontology: uberon/bridge/collected-metazoan
property_value: dc-creator "Uberon editors" xsd:string
property_value: dc-description "\nThis is an ontology that collects all of the core uberon, plus ALL\ngross anatomical ontologies for metazoans.\n    " xsd:string
property_value: dc-title "Uberon importer for metazoan structures" xsd:string
property_value: foaf-homepage http://purl.obolibrary.org/obo/uberon/bridge/collected-metazoa xsd:anyURI
