synonym: "larval tracheal cell" RELATED []
synonym: "larval tracheocyte" NARROW []
is_a: FBbt:00005038 ! tracheocyte (Drosophila)
relationship: part_of UBERON:0000922 ! embryo
relationship: part_of UBERON:0002548 ! larva

