[Term]
id: FBbt:00100502
name: adult neuropil associated glial cell (Drosophila)
def: "Glial cell of the adult that is associated with a neuropil of the brain. There are approximately 200 neuropil associated glial cells per hemisphere of the adult brain (Hartenstein, 2011)." [FlyBase:FBrf0206543, FlyBase:FBrf0214261]
is_a: FBbt:00100499 ! adult CNS glial cell (Drosophila)
relationship: part_of UBERON:0002606 ! neuropil

[Term]
id: FBbt:00100503
name: glial mesh (Drosophila)
def: "Mesh-like structure composed of glial cells and covering the cortex of the adult brain. It is composed of glial cells that locally elaborate and enwrap neuronal cell bodies." [FlyBase:FBrf0206543]
is_a: UBERON:0010000 ! multicellular anatomical structure

[Term]
id: FBbt:00100504
name: ensheathing neuropil associated glial cell (Drosophila)
def: "Glial cell of the adult brain that elaborates along the outer surface of its associated neuropil. Glia of this class may also surround neuropil bundles such as commissures or tracts." [FlyBase:FBrf0206543]
synonym: "ensheathing glial cell" EXACT []
synonym: "fibrous lamellar neuropil associated glial cell" EXACT []
synonym: "neuropil ensheathing glial cell" EXACT []
is_a: FBbt:00100502 ! adult neuropil associated glial cell (Drosophila)

[Term]
id: FBbt:00100505
name: reticular neuropil associated glial cell (Drosophila)
def: "Neuropil associated glial cell of the adult brain that has a dendritic morphology which elaborates inside the associated neuropil." [FlyBase:FBrf0206543]
synonym: "astrocyte-like neuropil associated glial cell" EXACT [FlyBase:FBrf0206543]
synonym: "dendritic neuropil associated glial cell" EXACT []
