is_a: FBbt:00007352 ! antennal olfactory receptor neuron (Drosophila)
relationship: part_of FBbt:00004180 ! grooved sensillum of sacculus (Drosophila)

[Term]
id: FBbt:00110991
name: mushroom body ventral accessory calyx (Drosophila)
def: "A small protrusion extending ventral lateral to the main mushroom body calyx. The dendritic arbors of gamma dorsal Kenyon cells are found in this region." [FlyBase:FBrf0227179]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of UBERON:0001058 ! mushroom body

[Term]
id: FBbt:00110992
name: mushroom body medial lobe arborizing neuron 8 (Drosophila)
def: "A neuron, which is part of a cluster of approximately 15 per brain hemisphere, whose cell body is found in the inferior neuropils in the dopaminergic PAM cluster. Its axon projects bilaterally to the beta lobe slices 1 or 2, both in the surface and core regions." [FlyBase:FBrf0222568]
synonym: "MB-M8" EXACT [FlyBase:FBrf0222568]
is_a: FBbt:00100214 ! dopaminergic PAM neuron (Drosophila)
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00110993
name: dopaminergic PAM neuron 4 (Drosophila)
def: "A mushroom body medial lobe arborizing neuron 8 (MB-M8) of the dopaminergic PAM cluster that projects bilaterally to the beta lobe slice 2. Dendritic arborizations are found in the superior intermediate and lateral protocerebrum. There are between 8-19 neurons of this type per hemisphere." [FlyBase:FBrf0227179]
synonym: "PAM-04" EXACT [FlyBase:FBrf0227179]
synonym: "PAM-beta2" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00110992 ! mushroom body medial lobe arborizing neuron 8 (Drosophila)

[Term]
id: FBbt:00110994
name: dopaminergic PAM neuron 10 (Drosophila)
def: "A mushroom body medial lobe arborizing neuron 8 (MB-M8) of the dopaminergic PAM cluster that projects bilaterally to the surface and core layers of the beta lobe slice 1. Dendritic arborizations are found in the superior intermediate and lateral protocerebrum. There are between 4-6 neurons of this type per hemisphere." [FlyBase:FBrf0227179]
synonym: "PAM-10" EXACT [FlyBase:FBrf0227179]
synonym: "PAM-beta1" EXACT [FlyBase:FBrf0227179]
