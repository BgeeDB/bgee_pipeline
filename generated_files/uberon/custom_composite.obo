[Term]
id: FBbt:00005898
name: ventral lobula cluster neuron (Drosophila)
def: "A neuron that is part of a cluster of atonal expressing neurons whose cell bodies are located ventrally in the lobula of the adult brain. It densely innervates the ventral lobula and extends towards the medulla." [FlyBase:FBrf0127108]
synonym: "ventral lobular cluster" RELATED [FlyBase:FBrf0127108]
synonym: "VLC neuron" EXACT [FlyBase:FBrf0127108]
is_a: CL:2000029 ! central nervous system neuron
is_a: FBbt:00003702 ! optic lobe neuron (Drosophila)
relationship: part_of UBERON:6003624 ! adult brain

[Term]
id: FBbt:00005899
name: dorsal cluster neuron (Drosophila)
def: "A neuron that is part of a cluster of atonal expressing neurons whose cell bodies are located dorsally in the cortex of the adult brain between the optic lobe and the central brain. It innervates the ipsilateral lobula, forming dense, dendrite-like trees, and projects to the contralateral hemisphere via a supraesophageal commissure to innervate the lobula. A third of DCN neurons also extend their axons into the contralateral medulla. The DCN cluster contains around 40 neurons." [FlyBase:FBrf0127108, FlyBase:FBrf0190369, FlyBase:FBrf0192599]
synonym: "DC neuron" EXACT [FlyBase:FBrf0127108]
synonym: "DCN" EXACT [FlyBase:FBrf0190369]
is_a: CL:2000029 ! central nervous system neuron
is_a: FBbt:00003702 ! optic lobe neuron (Drosophila)
relationship: part_of UBERON:6003624 ! adult brain

[Term]
id: FBbt:00005900
name: ventral brain cluster neuron (Drosophila)
def: "A neuron that is part of a cluster of atonal expressing neurons whose cell bodies are located ventrally in the central adult brain. It projects along the brain lobula border." [FlyBase:FBrf0127108]
synonym: "VBC neuron" EXACT [FlyBase:FBrf0127108]
is_a: CL:2000029 ! central nervous system neuron
is_a: FBbt:00003702 ! optic lobe neuron (Drosophila)
relationship: part_of UBERON:6003624 ! adult brain

