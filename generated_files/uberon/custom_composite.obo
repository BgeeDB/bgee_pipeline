synonym: "alpha''" EXACT []
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00015407 ! vertical lobe of adult mushroom body (Drosophila)

[Term]
id: FBbt:00100253
name: alpha'/beta' middle Kenyon cell (Drosophila)
def: "A subgroup of the mushroom body alpha'/beta' neurons that has dendrites in the main calyx and projects axons to the middle layer of the alpha' and beta' lobes. In the beta' lobe slice 2, their axons are located in the area between the bifurcating axons of the alpha'/beta' anterior-posterior Kenyon cell. In the alpha' lobe, their axons are medial to those of alpha'/beta' anterior-posterior Kenyon cell. There are around 140 neurons in each hemisphere." [FlyBase:FBrf0205263, FlyBase:FBrf0227179]
synonym: "alpha'/beta' m Kenyon cell" EXACT [FlyBase:FBrf0227179]
synonym: "alpha'/beta' middle neuron" EXACT [FlyBase:FBrf0205263]
