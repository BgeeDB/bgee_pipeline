relationship: part_of UBERON:0002296 {source="EHDAA2"} ! dorsal mesentery
property_value: external_definition "The dorsal sheet of the primitive mesentery that encloses the stomach. The greater omentum develops from the dorsal mesogastrium. [TFD][VHOG]" xsd:string {date_retrieved="2012-09-17", external_class="VHOG:0000352", ontology="VHOG", source="http://bgee.unil.ch/", source="http://medical-dictionary.thefreedictionary.com/mesogastrium"}

