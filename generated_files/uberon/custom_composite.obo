[Term]
id: FBbt:00111016
name: dopaminergic PAM neuron 2 (Drosophila)
def: "Dopaminergic neuron of the PAM cluster whose dendrites arborize the superior medial protocerebrum and crepine. The axon projects to the anterior layer of the beta' lobe slice 2. There are around 6-9 neurons of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "PAM-02" EXACT [FlyBase:FBrf0227179]
synonym: "PAM-beta'2a" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100214 ! dopaminergic PAM neuron (Drosophila)

[Term]
id: FBbt:00111017
name: dopaminergic PAM neuron 5 (Drosophila)
def: "A dopaminergic neuron of the PAM cluster that projects bilaterally to the posterior layer of the beta' lobe slice 2. Dendritic terminals are found in the superior medial protocerebrum and crepine. There are between 14-17 neurons of this type per hemisphere." [FlyBase:FBrf0227179]
synonym: "PAM-05" EXACT [FlyBase:FBrf0227179]
synonym: "PAM-beta'2p" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100214 ! dopaminergic PAM neuron (Drosophila)

[Term]
id: FBbt:00111018
name: dopaminergic PAM neuron 6 (Drosophila)
def: "A dopaminergic neuron of the PAM cluster that projects bilaterally to the middle layer of the beta' lobe slice 2. Dendritic terminals are found in the superior medial and intermediate protocerebrum and crepine. There are between 12-15 neurons of this type per hemisphere." [FlyBase:FBrf0227179]
synonym: "PAM-05" EXACT [FlyBase:FBrf0227179]
synonym: "PAM-beta'2m" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100214 ! dopaminergic PAM neuron (Drosophila)

[Term]
id: FBbt:00111019
name: dopaminergic PAM neuron 7 (Drosophila)
def: "A dopaminergic neuron of the PAM cluster that projects to the gamma lobe slices 1 and 2, with dendritic arborizations found in the gamma lobe slice 4, superior medial protocerebrum and crepine. There are between 13-17 neurons of this type per hemisphere." [FlyBase:FBrf0227179]
synonym: "PAM-07" EXACT [FlyBase:FBrf0227179]
synonym: "PAM-gamma4<gamma1gamma2" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100214 ! dopaminergic PAM neuron (Drosophila)

[Term]
id: FBbt:00111020
