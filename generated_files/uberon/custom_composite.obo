[Term]
id: UBERON:8400001
name: hepatic acinus periportal zone
namespace: uberon
def: "The region of the hepatic acinus closest to the portal triad. Blood in this zone has the highest oxygen concentration of the three metabolic zones in the hepatic acinus." [http://www.ncbi.nlm.nih.gov/pubmed/28126520]
synonym: "hepatic acinus zone 1" EXACT [http://www.ncbi.nlm.nih.gov/pubmed/28126520]
is_a: UBERON:0000063 ! organ subunit
relationship: dc-creator http://orcid.org/0000-0003-2034-601X
relationship: part_of UBERON:0001172 ! hepatic acinus
creation_date: 2020-09-08T14:14:21Z

[Term]
id: UBERON:8400002
name: hepatic acinus perivenous zone
namespace: uberon
def: "The region of the hepatic acinus closest to the central vein of the liver lobule. Blood in this zome has the lowest oxygen concentration of the three metabolic zones in the hepatic acinus." [http://www.ncbi.nlm.nih.gov/pubmed/28126520]
synonym: "hepatic acinus centrilobular zone" EXACT [http://www.ncbi.nlm.nih.gov/pubmed/28126520]
synonym: "hepatic acinus pericentral zone" EXACT [http://www.ncbi.nlm.nih.gov/pubmed/28126520]
synonym: "hepatic acinus zone 3" EXACT [http://www.ncbi.nlm.nih.gov/pubmed/28126520]
is_a: UBERON:0000063 ! organ subunit
relationship: dc-creator http://orcid.org/0000-0003-2034-601X
relationship: part_of UBERON:0001172 ! hepatic acinus
creation_date: 2020-09-08T15:05:03Z

[Term]
id: UBERON:8400003
name: hepatic acinus intermediary zone
namespace: uberon
def: "The region of the hepatic acinus in between the periportal zone and the perivenous zone. Blood in this region has an intermediate oxygen concentration relative to the other two zones of the hepatic acinus." [http://www.ncbi.nlm.nih.gov/pubmed/28126520]
synonym: "hepatic acinus zone 2" EXACT [http://www.ncbi.nlm.nih.gov/pubmed/28126520]
is_a: UBERON:0000063 ! organ subunit
relationship: dc-creator http://orcid.org/0000-0003-2034-601X
relationship: part_of UBERON:0001172 ! hepatic acinus
creation_date: 2020-09-08T15:15:57Z

