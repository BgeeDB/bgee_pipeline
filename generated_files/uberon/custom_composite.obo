is_a: FBbt:00005131 ! dopaminergic neuron (Drosophila)
relationship: part_of UBERON:6003624 ! adult brain

[Term]
id: FBbt:00110985
name: adult feeding interneuron (Drosophila)
def: "Neuron of the adult brain whose soma is located in the subesophageal zone. The primary neurite extends ventromedially and splits into 5 dendritic branches (dorsolateral, dorsomedial, medial, ventromedial, ventral) that form a dense network of arborization mostly in the medial subesophageal zone. The main axon extends along the lateral subesophageal zone. It is involved in inducing the normal feeding behaviour. There is one of these neurons in each hemisphere." [FlyBase:FBrf0222061]
synonym: "Fdg interneuron" EXACT [FlyBase:FBrf0222061]
is_a: CL:0000099 ! interneuron

[Term]
id: FBbt:00110986
name: transmedullary Y neuron Rh3TmY (Drosophila)
def: "Transmedullary Y neuron that projects to medulla layers M7-M10, to all four lobula plate layers and to the innermost lobula layer (Lo1) in a columnar manner. In the medulla, it contacts to two to three columns while in the lobula it is three columns. It is synapsed by the photoreceptor cell R7 of pale ommatidium." [FlyBase:FBrf0225846]
synonym: "Rh3TmY" EXACT [FlyBase:FBrf0225846]
is_a: FBbt:00110091 ! transmedullary Y neuron vGlutTmYnew1 (Drosophila)

