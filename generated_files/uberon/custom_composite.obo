is_a: FBbt:00007032 ! chitinous intima (Drosophila)
relationship: part_of FBbt:00003143 ! adult hindgut (Drosophila)

[Term]
id: FBbt:00007035
name: anterior adult hindgut (Drosophila)
def: "Segment of the adult hindgut extending from the pylorus to the rectal valve." [FlyBase:FBrf0075527]
synonym: "anterior intestine" EXACT [FlyBase:FBrf0007735]
synonym: "ileum" EXACT [FlyBase:FBrf0212594]
relationship: part_of FBbt:00003143 ! adult hindgut (Drosophila)

[Term]
id: FBbt:00007036
name: adult posterior midgut epithelium (Drosophila)
def: "A columnar - cuboidal epithelial monolayer with a brush border consisting predominantly of large polyploid enterocytes tied together by smooth septate junctions. Scattered through this epithelium are clusters of diploid intestinal stem cells and occasional enteroendocrine cells." [FlyBase:FBrf0007735, FlyBase:FBrf0139657, FlyBase:FBrf0191251]
is_a: UBERON:0000485 ! columnar epithelium
is_a: UBERON:0003352 ! epithelium of midgut
relationship: part_of FBbt:00007026 ! adult midgut epithelium (Drosophila)

[Term]
id: FBbt:00007037
name: enterocyte of posterior adult midgut epithelium (Drosophila)
def: "A large polyploid cuboidal or low-columnar epithelial cell with its nucleus in the middle and a mass of microvilli (brush border) on its apical surface. On its basal side, extensive infoldings of the plasma membrane form a labyrinth which fills the lower half of the cell. It is attached to adjacent enterocytes by smooth septate junctions." [FlyBase:FBrf0007735, FlyBase:FBrf0139657, FlyBase:FBrf0191251]
synonym: "EC" EXACT [FlyBase:FBrf0191251]
is_a: FBbt:00007042 ! enterocyte (Drosophila)
relationship: develops_from FBbt:00110206 ! enteroblast of posterior adult midgut epithelium (Drosophila)
relationship: part_of FBbt:00007036 ! adult posterior midgut epithelium (Drosophila)

[Term]
id: FBbt:00007038
name: enteroendocrine cell (Drosophila)
def: "Diploid endocrine cell which is part of the adult midgut epithelium." [FlyBase:FBrf0191251]
synonym: "ee" EXACT [FlyBase:FBrf0191251]
synonym: "epithelial enterocyte" EXACT [FlyBase:FBrf0219176]
is_a: FBbt:00007294 ! endocrine cell (Drosophila)
is_a: FBbt:00100318 ! somatic cell (Drosophila)
relationship: develops_from FBbt:00110205 ! enteroblast (Drosophila)
relationship: part_of FBbt:00007026 ! adult midgut epithelium (Drosophila)

[Term]
id: FBbt:00007039
name: intestinal stem cell (Drosophila)
def: "Wedge shaped diploid cell found in scattered clusters in the posterior midgut epithelium. The broad end of the wedge lies on the basement membrane and contains the nucleus. The tapering apex of the cell extends up towards the lumen." [FlyBase:FBrf0007735, FlyBase:FBrf0191251]
synonym: "ISC" EXACT [FlyBase:FBrf0191251]
is_a: FBbt:00007344 ! somatic stem cell (Drosophila)
relationship: part_of FBbt:00007026 ! adult midgut epithelium (Drosophila)

[Term]
id: FBbt:00007040
name: adult anterior midgut epithelium (Drosophila)
def: "Columnar epithelium with a clear apical border (i.e. no brush border)." [FlyBase:FBrf0007735]
is_a: UBERON:0000485 ! columnar epithelium
is_a: UBERON:0003352 ! epithelium of midgut
relationship: part_of FBbt:00007026 ! adult midgut epithelium (Drosophila)

[Term]
id: FBbt:00007041
name: chitinous intima of the cardial valve (Drosophila)
def: "Cuticle layer that lines the regions of the adult proventriculus (cardia) that derive from the foregut, including the inner and intermediate layers. The cuticle is thicker in the inner layer than in other regions of the proventriculus, forming several longitudinal folds and causing the esophageal lumen to appear irregular in cross-section." [FlyBase:FBrf0007735, FlyBase:FBrf0048518]
synonym: "stomodaeal intima" EXACT [FlyBase:FBrf0007735]
relationship: part_of FBbt:00007033 ! chitinous intima of the adult foregut (Drosophila)

[Term]
id: FBbt:00007042
name: enterocyte (Drosophila)
def: "Specialised epithelial cell of the adult midgut. A large polyploid cuboidal or low-columnar epithelial cell with its nucleus in the middle and a mass of microvilli (brush border) on its apical surface. On its basal side, extensive infoldings of the plasma membrane form a labyrinth which fills the lower half of the cell. It is attached to adjacent enterocytes by smooth septate junctions." [FlyBase:FBrf0007735, FlyBase:FBrf0139657, FlyBase:FBrf0191251]
synonym: "EC" EXACT [FlyBase:FBrf0191251]
is_a: CL:0002251 ! epithelial cell of alimentary canal
relationship: develops_from FBbt:00110205 ! enteroblast (Drosophila)
relationship: part_of FBbt:00007026 ! adult midgut epithelium (Drosophila)

[Term]
id: FBbt:00007043
name: adult cardial valve muscle (Drosophila)
def: "Layer of longitudinal muscle fibers found between the inner and intermediate layers of the adult proventriculus (cardia). These muscle fibers are embedded in an extracellular matrix that fills the available space." [FlyBase:FBrf0007735, FlyBase:FBrf0048518]
synonym: "hilus" EXACT [FlyBase:FBrf0048518]
is_a: CL:0002078 ! meso-epithelial cell
is_a: CL:0002251 ! epithelial cell of alimentary canal
is_a: UBERON:0000077 ! mixed endoderm/mesoderm-derived structure
is_a: UBERON:0001135 ! smooth muscle tissue
relationship: part_of FBbt:00003140 ! cardial valve (Drosophila)

[Term]
id: FBbt:00007044
name: adult midgut pyloric epithelium (Drosophila)
def: "Squamous epithelium which forms the posterior-most region of the midgut epithelium, from the Malpighian tubules to the beginning of the hindgut." [FlyBase:FBrf0007735]
is_a: FBbt:00007028 ! squamous epithelium (Drosophila)
is_a: UBERON:0003352 ! epithelium of midgut
relationship: part_of FBbt:00007026 ! adult midgut epithelium (Drosophila)
relationship: part_of FBbt:00100784 ! adult pylorus (Drosophila)

