property_value: IAO:0000412 http://purl.obolibrary.org/obo/cl.owl

[Term]
id: CL:0000001
name: primary cultured cell
namespace: cell
def: "A cultured cell that is freshly isolated from a organismal source, or derives in culture from such a cell prior to the culture being passaged." []
comment: Covers cells actively being cultured or stored in a quiescent state for future use.
synonym: "primary cell culture cell" EXACT []
synonym: "primary cell line cell" RELATED []
synonym: "unpassaged cultured cell" EXACT []
