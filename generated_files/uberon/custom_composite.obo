relationship: part_of FBbt:00007685 ! auditory system (Drosophila)

[Term]
id: FBbt:00110128
name: dopaminergic VUM neuron (Drosophila)
def: "A dopaminergic neuron whose cell body is located ventromedially in the gnathal ganglion of the adult brain. It arborizes extensively in the ventroanterior area of the subesophageal zone with presynaptic terminals found throughout. It is involved in modulating the proboscis extension response (PER) with its activity being sufficient to trigger PER (Marella et al., 2012)." [FlyBase:FBrf0217751]
synonym: "TH-VUM" EXACT [FlyBase:FBrf0217751]
is_a: CL:2000029 ! central nervous system neuron
is_a: FBbt:00005131 ! dopaminergic neuron (Drosophila)
relationship: part_of FBbt:00110639 ! adult subesophageal zone (Drosophila)

[Term]
id: FBbt:00110129
