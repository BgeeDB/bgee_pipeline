synonym: "ossa metacarpi [I-V]" EXACT LATIN [FMA:71336, FMA:TA]
synonym: "set of metacarpal bones" EXACT [FMA:71336]
synonym: "set of metacarpals" EXACT [FMA:71336]
synonym: "set of metacarpals [I-V]" EXACT [FMA:71336]
synonym: "skeleton of metacarpus" EXACT []
