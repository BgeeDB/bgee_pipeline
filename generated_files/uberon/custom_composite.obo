relationship: develops_from UBERON:0003104 ! mesenchyme
property_value: external_comment "[In TAO], This term was made obsolete because it is considered a synonym of membrane bone (VSAO:0000023).[TAO]" xsd:string {date_retrieved="2012-09-06", external_class="TAO:0001644", ontology="TAO", source="Curator"}
