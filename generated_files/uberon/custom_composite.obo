[Term]
id: FBbt:00004541
name: mediproboscis (Drosophila)
def: "Cylindrical membranous tube that is the proximal part of the proboscis." [FlyBase:FBrf0031004, FlyBase:FBrf0033866]
synonym: "haustellum" EXACT [FlyBase:FBrf0033866]
