id: FBbt:00027001
name: posterior wing margin (Drosophila)
def: "Wing margin of the posterior compartment of the wing." [FBC:DOS]
is_a: FBbt:00085378 ! section of wing margin (Drosophila)

[Term]
id: FBbt:00040000
name: adult antennal lobe projection neuron DC3 adPN (Drosophila)
def: "Antennal lobe projection neuron from the ad neuroblast lineage whose dendrites innervate only antennal lobe glomerulus DC3. Neurons of this class are derived from the sixth larval division of the neuroblast ALad1 (FBbt:00067346) (Yu et al., 2010). The axons of these neurons innervate a small area at the anterior edge of the lateral horn, in a similar region to VL2a and VA1lm PNs." [doi:10.1371/journal.pbio.1000461.g002, FlyBase:FBrf0174482, FlyBase:FBrf0203179, FlyBase:FBrf0206335, FlyBase:FBrf0211729, FlyBase:FBrf0224383]
synonym: "DC3 adPN" EXACT []
is_a: FBbt:00003991 ! unilateral ACT relay interneuron (Drosophila)
is_a: FBbt:00100368 ! adult uniglomerular antennal lobe projection neuron adPN (Drosophila)

[Term]
id: FBbt:00040001
name: lateral complex (Drosophila)
def: "A synaptic neuropil block in the adult brain that lies anterior and lateral to the central complex, with which it is closely associated. Unlike components of the central complex, it is not separated from surrounding neuropils by a glial sheath." [FlyBase:FBrf0224194]
synonym: "LX" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6041000 ! synaptic neuropil block
relationship: part_of UBERON:6110636 ! adult cerebral ganglion

[Term]
id: FBbt:00040002
name: ventromedial neuropils (Drosophila)
def: "A group of synaptic neuropil domains in the adult brain located above or and lateral to the esophagus, below the mushroom body calyx and inferior neuropils, behind the lateral accessory lobe and medial to the ventrolateral neuropils." [FlyBase:FBrf0224194]
synonym: "VMNPS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6041000 ! synaptic neuropil block
relationship: part_of UBERON:6110636 ! adult cerebral ganglion

[Term]
id: FBbt:00040004
name: tract neuropil (Drosophila)
def: "The part of the neuropil consisting largely of neuron projections without synapses." [FlyBase:FBrf0224194]
synonym: "fibrous neuropil" RELATED []
relationship: part_of UBERON:0002606 ! neuropil

[Term]
id: FBbt:00040006
name: synaptic neuropil subdomain (Drosophila)
def: "Synaptic neuropil region that is a subdivision of a synaptic neuropil domain." [FlyBase:FBrf0224194]
xref: FBbt:00051393
relationship: part_of UBERON:6040005 ! synaptic neuropil

[Term]
id: FBbt:00040008
name: synaptic neuropil layer (Drosophila)
def: "Laminar or concentric subdivision of a synaptic neuropil domain along its long axis delimited by a discontinuity in synaptic or fiber density." [FBC:DOS, FBC:KI]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)

[Term]
id: FBbt:00040016
name: lobula layer 5 (Drosophila)
def: "Layer of the lobula that is fifth-most from the second optic-chiasm. It extends from the terminal arborizations of translobula plate neuron Tlp1 at the border of the fourth layer, to the extensive arborizations of lobula tangential neuron Lt7, which defines layer 6." [FlyBase:FBrf0049410]
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003852 ! lobula (Drosophila)

[Term]
id: FBbt:00040017
name: lobula layer 6 (Drosophila)
def: "Layer of the lobula that is the most distant from the second optic chiasm. It contains the extensive arborizations of lobula tangential neuron Lt7." [FlyBase:FBrf0049410]
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003852 ! lobula (Drosophila)

[Term]
id: FBbt:00040033
name: nodulus subunit (Drosophila)
def: "Subunit of the nodulus in the adult brain with a lobular appearance. There are three subunits stacked on top of each other (I, II and III) and a fourth subunit (IV) more posteriorly." [FlyBase:FBrf0224194]
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003680 ! nodulus (Drosophila)

[Term]
id: FBbt:00040034
name: ellipsoid body layer (Drosophila)
def: "A concentric subdivision of the ellipsoid body resulting from the arborization patterns of the ring neurons (FBbt:00003649)." [FlyBase:FBrf0049409, FlyBase:FBrf0111476, FlyBase:FBrf0224194]
synonym: "ellipsoid body ring" RELATED [FlyBase:FBrf0049409]
synonym: "layer of ellipsoid body" EXACT []
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003678 ! ellipsoid body (Drosophila)

[Term]
id: FBbt:00040035
name: fan-shaped body layer (Drosophila)
def: "Horizontal, laminar subdivision of the fan-shaped body that results from the stratification of large field neurons. There are 8 layers that run parallel to each other." [FlyBase:FBrf0049409, FlyBase:FBrf0210156, FlyBase:FBrf0224194]
synonym: "layer of fan-shaped body" EXACT []
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003679 ! fan-shaped body (Drosophila)

[Term]
id: FBbt:00040036
name: fan-shaped body slice (Drosophila)
def: "Subdivision of the fan-shaped body along the transverse axis resulting from the arrangement of vertical fibers." [FlyBase:FBrf0049409]
synonym: "segment of fan-shaped body" EXACT []
synonym: "stave of fan-shaped body" EXACT [FlyBase:FBrf0049409]
is_a: FBbt:00040069 ! synaptic neuropil segment (Drosophila)
relationship: part_of FBbt:00003679 ! fan-shaped body (Drosophila)

[Term]
id: FBbt:00040037
name: inferior neuropils (Drosophila)
def: "Block of synaptic neuropil domains in the adult brain located below the superior neuropils, around the level of the mushroom body medial lobe and pedunculus." [FlyBase:FBrf0224194]
synonym: "inferior protocerebrum" EXACT []
synonym: "INP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6041000 ! synaptic neuropil block
relationship: part_of UBERON:6110636 ! adult cerebral ganglion

[Term]
id: FBbt:00040038
name: rubus (Drosophila)
def: "The rubus is a small subregion that is embedded in the crepine, lying behind the mushroom body medial lobe. It consists of a small rough-surfaced round-ish structure. Fibers from the central complex form specific output terminals in this subregion, an project further towards the gall." [FlyBase:FBrf0224194]
synonym: "RUB" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00045037 ! crepine (Drosophila)

[Term]
id: FBbt:00040039
name: gorget (Drosophila)
def: "A thin plate-like, bilaterally paired synaptic neuropil domain that protrudes medially from below the inferior clamp to the area between the great commissure and the central body. Its medial tip extends towards the noduli." [FlyBase:FBrf0224194, VFB_vol:00040039]
synonym: "GOR" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "vmpr" RELATED [FlyBase:FBrf0193607]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00040071 ! ventral complex (Drosophila)

[Term]
id: FBbt:00040040
name: epaulette (Drosophila)
def: "A small, bilaterally paired synaptic neuropil domain of the ventral complex, lying below the inferior clamp and superior-lateral to the vest." [FlyBase:FBrf0224194, VFB_vol:00040040]
synonym: "EPA" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "vmpr" RELATED [FlyBase:FBrf0193607]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00040071 ! ventral complex (Drosophila)

[Term]
id: FBbt:00040041
name: vest (Drosophila)
def: "Bilaterally paired synaptic neuropil domain that is the largest and most medial domain of the ventral complex. Its inferior (ventral) boundary with the saddle is demarcated by a glial sheath and the medial and lateral sides are flanked respectively by the esophagus and inferior fiber system." [FlyBase:FBrf0224194, VFB_vol:00040041]
synonym: "VES" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "vmpr" RELATED [FlyBase:FBrf0193607]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00040071 ! ventral complex (Drosophila)

[Term]
id: FBbt:00040042
name: posterior ventrolateral protocerebrum (Drosophila)
def: "A glomerular, bilaterally paired synaptic neuropil domain lying in front of the posterior lateral protocerebrum (PLP), and above the wedge. The great commissure is at the boundary in the mid-level between the PLVP and PLP. It is contiguous with posterior lateral protocerebrum (PLP), which lies behind it. It houses many optic glomeruli formed by the terminals of neurons projecting from the optic lobe, primarily from the lobula. The boundary with the PLP, except at mid-level, is defined as the boundary between these glomeruli with different origins (lobula or lobula plate)." [FlyBase:FBrf0224194, VFB_vol:00040042]
synonym: "posterior VLP" EXACT []
synonym: "PVLP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00007058 ! ventrolateral protocerebrum (Drosophila)

[Term]
id: FBbt:00040043
name: anterior ventrolateral protocerebrum (Drosophila)
def: "An aglomerular, bilaterally paired synaptic neuropil domain of the ventrolateral protocerebrum (VLP) that protrudes from the anterior brain between the optic lobe and the antennal lobe. It is located in front of the posterior VLP and below the anterior optic tubercle and superior clamp. It receives input from neurons projecting from the optic lobe." [FlyBase:FBrf0224194, VFB_vol:00040043]
synonym: "anterior VLP" EXACT []
synonym: "AVLP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00007058 ! ventrolateral protocerebrum (Drosophila)

[Term]
id: FBbt:00040044
name: posterior lateral protocerebrum (Drosophila)
def: "A bilaterally paired synaptic neuropil domain that contains many glomeruli and is located behind the posterior ventrolateral protocerebrum (PVLP) and above the wedge. The mid-level of the posterior lateral protocerebrum (PLP) is separated from the PVLP by the great commissure, but above and below this the two neuropils are contiguous. The PLP houses many optic glomeruli formed by the terminals of neurons projecting from the optic lobe, primarily from the lobula plate. The boundary with the PVLP is defined by the boundary between these glomeruli that have different origins (lobula or lobula plate)." [FlyBase:FBrf0224194, VFB_vol:00040044]
synonym: "PLP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "plpr" RELATED [FlyBase:FBrf0193607]
synonym: "posteriolateral protocerebrum" EXACT []
synonym: "posterior-lateral protocerebrum" EXACT []
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00045021 ! ventrolateral neuropils (Drosophila)

[Term]
id: FBbt:00040045
name: anterior superior lateral protocerebrum (Drosophila)
def: "Anterior subregion of the superior lateral protocerebrum." [FlyBase:FBrf0224194]
synonym: "ASLP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "middle slpr" EXACT [FlyBase:FBrf0193607]
synonym: "mslpr" EXACT [FlyBase:FBrf0193607]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00007054 ! superior lateral protocerebrum (Drosophila)

[Term]
id: FBbt:00040046
name: posterior superior lateral protocerebrum (Drosophila)
def: "Posterior subregion of the superior lateral protocerebrum." [FlyBase:FBrf0224194]
synonym: "posterior SLP" EXACT []
synonym: "posterior splr" RELATED [FlyBase:FBrf0193607]
synonym: "PSLP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "pslpr" RELATED [FlyBase:FBrf0193607]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00007054 ! superior lateral protocerebrum (Drosophila)

[Term]
id: FBbt:00040047
name: clamp (Drosophila)
def: "Synaptic neuropil domain lying between the fan-shaped body, the protocerebral bridge and mushroom body pedunculus, including the area above and below the pedunculus (the space occupied by the pedunculus forms a deep tunnel-like recess on its inferior lateral side). Few neurons in the clamp penetrate the pedunculus, but some enter the glomerular posterior lateral protocerebrum and posterior ventrolateral protocerebrum (PLP, PVLP), forming a characteristic cylindrical architecture around the pedunculus. Some fibers spanning the superior surface project into the superior arch commissure." [FlyBase:FBrf0224194, VFB_vol:00040047]
synonym: "CL" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00040037 ! inferior neuropils (Drosophila)

[Term]
id: FBbt:00040048
name: superior clamp (Drosophila)
def: "Superior (dorsal) part of the clamp, above the dorsal surface of the mushroom body pedunculus and in front of the mushroom body calyx. It is located above the superior ellipsoid commissure (SEC) and superior arch commissure (SAC)." [FlyBase:FBrf0224194]
synonym: "ilpr" RELATED [FlyBase:FBrf0193607]
synonym: "impr" RELATED [FlyBase:FBrf0193607]
synonym: "SCL" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00040047 ! clamp (Drosophila)

[Term]
id: FBbt:00040049
name: inferior clamp (Drosophila)
def: "Inferior (ventral) part of the clamp, between the pedunculus and the central complex. It is located below the superior ellipsoid commissure (SEC) and superior arch commissure (SAC)." [FlyBase:FBrf0224194]
synonym: "ICL" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00040047 ! clamp (Drosophila)

[Term]
id: FBbt:00040050
name: inferior bridge (Drosophila)
def: "Posterior-most synaptic neuropil domain of the midline. It is the only synaptic neuropil domain outside of the central complex that is fused across the midline. It is located behind the fan-shaped body and below the protocerebral bridge." [FlyBase:FBrf0224194, VFB_vol:00040050]
synonym: "IB" EXACT [FlyBase:FBrf0224194]
synonym: "spsl" RELATED [FlyBase:FBrf0193607]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00040037 ! inferior neuropils (Drosophila)

[Term]
id: FBbt:00040051
name: prow (Drosophila)
def: "Anteriormost and superior synaptic neuropil domain below the esophagus. It lies inferior and anterior to the opening of the esophageal foramen. It houses the superior pharyngeal sensory center (SPhS), containing the terminals of peripheral axons from the pharyngeal nerve." [FlyBase:FBrf0224194, VFB_vol:00040051]
synonym: "PRW" EXACT [FlyBase:FBrf0224194]
relationship: part_of FBbt:00045047 ! periesophageal neuropils (Drosophila)
relationship: part_of FBbt:00110639 ! adult subesophageal zone (Drosophila)

[Term]
id: FBbt:00040052
name: superior pharyngeal sensory center (Drosophila)
def: "Region of the prow containing terminals of peripheral axons from the superior branch of the pharyngeal and accessory pharyngeal nerves." [FlyBase:FBrf0224194]
synonym: "dorsal pharyngeal sensory center" EXACT [FlyBase:FBrf0224194]
synonym: "SPhS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00040051 ! prow (Drosophila)

[Term]
id: FBbt:00040054
name: inferior pharyngeal sensory center (Drosophila)
def: "Region of the subesophageal zone of the adult brain containing terminals of peripheral axons from the inferior branch of the pharyngeal and accessory pharyngeal nerves. Two distinct subregions can be identified: one dorsal to the AMS1 (VPS1) and another medial to AMS1 and dorsal to AMS3 (VPS2)." [FlyBase:FBrf0211916, FlyBase:FBrf0224194]
synonym: "IPhS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "ventral pharyngeal sensory center" EXACT [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00014013 ! adult gnathal ganglion (Drosophila)

[Term]
id: FBbt:00040055
name: labial sensory center (Drosophila)
def: "Region of the gnathal ganglion of the adult brain containing terminals of peripheral axons from the posterior branch of the maxillary-labial nerve, from of a subset of gustatory receptor neurons of labellum sensilla. Three distinct subregions can be identified: a posterior zone (LS1), a ventral protrusion on the posterior side of LS1 (LS2) and an anterior medial zone (LS3)." [FlyBase:FBrf0211916, FlyBase:FBrf0224194]
synonym: "labellar sensory center" EXACT []
synonym: "LS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00014013 ! adult gnathal ganglion (Drosophila)

[Term]
id: FBbt:00040056
name: posterior maxillary sensory center (Drosophila)
def: "Region of the gnathal ganglion of the adult brain containing terminals of peripheral axons from the posterior secondary branch from the anterior branch of the maxillary-labial nerve, from of a subset of gustatory receptor neurons of labellum sensilla. Five distinct subregions can be identified: a horn-like protrusion in the dorsolateral GNG (PMS1), a dorsal medial region (PMS2), a ventral medial region (PMS3), a zone near the entry point of the labial nerve (PMS4) and a zone ventral to PSM3 (PSM5)." [FlyBase:FBrf0211916, FlyBase:FBrf0224194]
synonym: "PMS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00007158 ! adult maxillary neuromere (Drosophila)
relationship: part_of FBbt:00014013 ! adult gnathal ganglion (Drosophila)

[Term]
id: FBbt:00040057
name: anterior maxillary sensory center (Drosophila)
def: "Region of the gnathal ganglion of the adult brain containing terminals of peripheral axons from the anterior secondary branch from the anterior branch of the maxillary-labial nerve, from of a subset of gustatory receptor neurons of labellum sensilla. Three distinct subregions can be identified: a lateral anteriormost zone (AMS1), a lateralmost zone (AMS2) and a medial zone that reaches the midline (AMS3)." [FlyBase:FBrf0211916, FlyBase:FBrf0224194]
synonym: "AMS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00007158 ! adult maxillary neuromere (Drosophila)
relationship: part_of FBbt:00014013 ! adult gnathal ganglion (Drosophila)

[Term]
id: FBbt:00040059
name: upper lateral accessory lobe (Drosophila)
def: "Upper region of the lateral accessory lobe (LAL), divided from the lower region by fibers extending from the LAL commissure, through the center of the LAL." [FlyBase:FBrf0224194]
synonym: "ULAL" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00003681 ! lateral accessory lobe (Drosophila)

[Term]
id: FBbt:00040060
name: gall (Drosophila)
def: "A small region of the lateral accessory lobe that protrudes from its superior-lateral tip, just medial to the ventro-lateral protocerebrum and beneath the spur of the mushroom body. It is densely packed with synapses and sparsely surrounded by glia." [FlyBase:FBrf0224194]
synonym: "GA" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00003681 ! lateral accessory lobe (Drosophila)

[Term]
id: FBbt:00040061
name: lower lateral accessory lobe (Drosophila)
def: "Lower region of the lateral accessory lobe (LAL), divided from the upper region by fibers extending from the LAL commissure, through the center of the LAL." [FlyBase:FBrf0224194]
synonym: "LLAL" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00003681 ! lateral accessory lobe (Drosophila)

[Term]
id: FBbt:00040062
name: anterior superior medial protocerebrum (Drosophila)
def: "Region of the superior medial protocerebrum anterior to the fan-shaped body." [FlyBase:FBrf0224194]
synonym: "anterior SMP" EXACT []
synonym: "ASMP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00007055 ! superior medial protocerebrum (Drosophila)

[Term]
id: FBbt:00040063
name: posterior superior medial protocerebrum (Drosophila)
def: "Region of the superior medial protocerebrum posterior to the fan-shaped body." [FlyBase:FBrf0224194]
synonym: "posterior SMP" EXACT []
synonym: "PSMP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00007055 ! superior medial protocerebrum (Drosophila)

[Term]
id: FBbt:00040069
name: synaptic neuropil segment (Drosophila)
def: "Laminar or radial subdivision of a synaptic neuropil domain along its short axis delimited by a discontinuity in synaptic or fiber density." [FBC:DOS, FBC:KI]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)

[Term]
id: FBbt:00040070
name: ellipsoid body slice (Drosophila)
def: "A radial subdivision of the ellipsoid body arising from the arborization patterns of small field radial fibers. There are 16 of these per ellipsoid body, 8 per hemisphere numbered 1-8, from superior medial to inferior medial." [FlyBase:FBrf0049409, FlyBase:FBrf0224194]
synonym: "ellipsoid body glomerulus" EXACT [FlyBase:FBrf0111476]
synonym: "ellipsoid body sector" EXACT [FlyBase:FBrf0049409]
synonym: "ellipsoid body segment" EXACT []
synonym: "segment of ellipsoid body" EXACT []
is_a: FBbt:00040069 ! synaptic neuropil segment (Drosophila)
relationship: part_of FBbt:00003678 ! ellipsoid body (Drosophila)

[Term]
id: FBbt:00040071
name: ventral complex (Drosophila)
def: "A group of synaptic neuropil domains in the adult brain located below (ventral to) the central complex, behind the lateral accessory lobes and in front of the great commissure. In includes the vest, epaulette and gorget." [FlyBase:FBrf0224194]
synonym: "vmpr" RELATED [FlyBase:FBrf0193607]
synonym: "VX" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
relationship: part_of FBbt:00040002 ! ventromedial neuropils (Drosophila)

[Term]
id: FBbt:00040072
name: posterior slope (Drosophila)
def: "Synaptic neuropil domain of the adult brain that is the inferior (ventral) part of the posterior cerebral ganglion, covering the area between the inferior bridge and the gnathal ganglion with its superior part lying behind the ventral complex. It contains extensive arborizations of ascending and descending neurons. Its superior boundary is the level above which such arborizations do not occur. It also contains the terminals of axons from the ocellar ganglia, projecting via the ocellar nerve." [FlyBase:FBrf0224194, VFB_vol:00040072]
synonym: "PS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00040002 ! ventromedial neuropils (Drosophila)

[Term]
id: FBbt:00045000
name: lamina dorsal rim area (Drosophila)
def: "Region of the dorsal lamina that receives input from the dorsal rim ommatidia." [FlyBase:FBrf0224194]
synonym: "LADRA" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003708 ! lamina (Drosophila)

[Term]
id: FBbt:00045001
name: plexiform medulla (Drosophila)
def: "Region of the medulla excluding the medulla dorsal rim area." [FlyBase:FBrf0224194]
synonym: "medulla proper" EXACT []
synonym: "MEP" EXACT []
synonym: "PLME" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003748 ! medulla (Drosophila)

[Term]
id: FBbt:00045002
name: medulla dorsal rim area (Drosophila)
def: "Region of the dorsal medulla that receives input from the lamina dorsal rim area." [FlyBase:FBrf0224194]
synonym: "dorsal rim area of medulla" EXACT []
synonym: "MEDRA" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040008 ! synaptic neuropil layer (Drosophila)
relationship: part_of FBbt:00003748 ! medulla (Drosophila)

[Term]
id: FBbt:00045003
name: accessory medulla (Drosophila)
def: "A small area of the neuropil on the frontomedial edge of the medulla, close to the outgoing fibers running from the serpentine layer to the posterior optic commissure." [FlyBase:FBrf0193849, FlyBase:FBrf0224194]
synonym: "AME" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "aMe" EXACT [FlyBase:FBrf0193849]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00003748 ! medulla (Drosophila)

[Term]
id: FBbt:00045004
name: lobula complex (Drosophila)
def: "A synaptic neuropil block in the adult brain consisting of the two medial-most synaptic neuropil domains of the optic lobe: the lobula and the lobula plate." [FlyBase:FBrf0224194]
synonym: "LOX" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6041000 ! synaptic neuropil block
relationship: part_of UBERON:0006795 ! arthropod optic lobe
relationship: part_of UBERON:6110636 ! adult cerebral ganglion

[Term]
id: FBbt:00045005
name: mushroom body medial calyx (Drosophila)
synonym: "MCA" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00003685 ! mushroom body calyx (Drosophila)

[Term]
id: FBbt:00045006
name: mushroom body lateral calyx (Drosophila)
synonym: "LCA" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00003685 ! mushroom body calyx (Drosophila)

[Term]
id: FBbt:00045007
name: mushroom body accessory calyx (Drosophila)
def: "A small subregion of the main mushroom body calyx that does not receive direct olfactory input. It protrudes from the anterior-dorsal edge of the main calyx into the superior lateral protocerebrum, above and anterior to the medial antennal lobe tract." [FlyBase:FBrf0205263]
synonym: "ACA" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "dorsal accessory calyx" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of UBERON:0001058 ! mushroom body

[Term]
id: FBbt:00045008
name: pedunculus neck of adult mushroom body (Drosophila)
def: "The proximal (posterior or posterior superior) point of the pedunculus at which Kenyon cell fibers converge beneath the calyx to form the pedunculus." [FlyBase:FBrf0224194]
synonym: "PEDN" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "pedunculus neck" EXACT []
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00007453 ! pedunculus of adult mushroom body (Drosophila)

[Term]
id: FBbt:00045009
name: pedunculus divide of adult mushroom body (Drosophila)
def: "The anterior end of the pedunculus of the adult mushroom body, where the Kenyon cell fibers bifurcate to project to the vertical and medial lobes." [FlyBase:FBrf0224194]
synonym: "heel" EXACT []
synonym: "knee" EXACT []
synonym: "lobe junction" EXACT []
synonym: "PEDD" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "pedunculus divide" EXACT []
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00007453 ! pedunculus of adult mushroom body (Drosophila)

[Term]
id: FBbt:00045010
name: mushroom body spur (Drosophila)
def: "Synaptic neuropil domain that is a small protrusion, lateral to the anterior end of the pedunculus." [FlyBase:FBrf0224194, VFB_vol:00045010]
synonym: "heel of mushroom body" EXACT []
synonym: "knee of mushroom body" RELATED []
synonym: "mushroom body heel" EXACT []
synonym: "SPU" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of UBERON:0001058 ! mushroom body

[Term]
id: FBbt:00045014
name: mushroom body vertical lobelet (Drosophila)
def: "Protrusions in the alpha accessory calyx layer (posterior, alpha-p) in the vertical lobe, formed by the fibers of the alpha/beta posterior Kenyon cells." [FlyBase:FBrf0224194]
synonym: "mushroom body alpha accessory calyx fibers" EXACT []
relationship: part_of FBbt:00100256 ! mushroom body alpha lobe posterior layer (Drosophila)

[Term]
id: FBbt:00045018
name: mushroom body medial lobelet (Drosophila)
def: "Protrusions in the beta accessory calyx layer (posterior, beta-p) in the medial lobe, formed by the fibers of the alpha/beta posterior Kenyon cells." [FlyBase:FBrf0224194]
synonym: "mushroom body beta accessory calyx fibers" EXACT []
relationship: part_of FBbt:00100261 ! mushroom body beta lobe posterior layer (Drosophila)

[Term]
id: FBbt:00045020
name: central body (Drosophila)
def: "Region of synaptic neuropil consisting of the fan-shaped body and the ellipsoid body." [FlyBase:FBrf0224194, VFB_vol:00045020]
synonym: "CB" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of UBERON:6003632 ! adult central complex

[Term]
id: FBbt:00045021
name: ventrolateral neuropils (Drosophila)
def: "Synaptic neuropil block in the adult brain located along the ventrolateral side of the adult central brain." [FlyBase:FBrf0224194]
synonym: "VLNP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6041000 ! synaptic neuropil block
relationship: part_of UBERON:6110636 ! adult cerebral ganglion

[Term]
id: FBbt:00045027
name: wedge (Drosophila)
def: "An aglomerular, bilaterally paired synaptic neuropil domain that is the inferior-most domain of the ventrolateral neuropils, lying between the anterior and posterior ventrolateral protocerebrum (AVLP and PVLP) and posteriorlateral protocerebrum (PLP), and the saddle and gnathal ganglion. The wedge is lateral to the inferior fiber system and vest. It receives synaptic input from the saddle and the antennal mechanosensory and motor center (AMMC) within it. This includes direct sensory input from antennal mechanosensory neurons that also innervate the AMMC." [FlyBase:FBrf0224194, VFB_vol:00045027]
synonym: "caudal VLP" RELATED []
synonym: "CVLP" RELATED []
synonym: "inferior ventrolateral protocerebrum" EXACT [FlyBase:FBrf0224194]
synonym: "inferior VLP" EXACT [FlyBase:FBrf0224194]
synonym: "IVLP" EXACT [FlyBase:FBrf0224194]
synonym: "plpr" RELATED [FlyBase:FBrf0193607]
synonym: "vlpr" RELATED [FlyBase:FBrf0193607]
synonym: "WED" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00045021 ! ventrolateral neuropils (Drosophila)

[Term]
id: FBbt:00045030
name: superior neuropils (Drosophila)
def: "A block of synaptic neuropil domains in the adult brain arranged in a layer covering the superior (dorsal) surface of the brain. In encompasses the superior intermediate, superior lateral and superior medial protocerebrum." [FlyBase:FBrf0224194]
synonym: "SNP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6041000 ! synaptic neuropil block
relationship: part_of UBERON:6110636 ! adult cerebral ganglion

[Term]
id: FBbt:00045032
name: superior intermediate protocerebrum (Drosophila)
def: "A small synaptic neuropil domain located around and posterior to the mushroom body vertical lobe, in front of the superior fiber system and above the superior clamp. This domain is rich in loose fibers that project from the anterior optic tubercle in a medial-posterior direction. It also houses the arborizations of many neurons that connect with the vertical lobes." [FlyBase:FBrf0224194, VFB_vol:00045032]
synonym: "impr" RELATED [FlyBase:FBrf0193607]
synonym: "SIP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "smpr" RELATED [FlyBase:FBrf0193607]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00045030 ! superior neuropils (Drosophila)

[Term]
id: FBbt:00045037
name: crepine (Drosophila)
def: "A thin, bilaterally paired synaptic neuropil domain that wraps around the medial lobe of the mushroom body. Many neurons in this domain enter the lobes to form extensive connections with Kenyon cell fibers." [FlyBase:FBrf0224194, VFB_vol:00045037]
synonym: "aimpr" RELATED [FlyBase:FBrf0193607]
synonym: "CRE" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00040037 ! inferior neuropils (Drosophila)

[Term]
id: FBbt:00045039
name: antler (Drosophila)
def: "Thin, elongated, antler-shaped, bilaterally paired synaptic neuropil domain spanning from the inferior bridge to the inferior edge of the superior lateral protocerebrum. It runs through the space between the protocerebral bridge and the fan-shaped body, along the medial surface of the medial antennal lobe tract." [FlyBase:FBrf0224194, VFB_vol:00045039]
synonym: "ATL" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "pimpr" RELATED [FlyBase:FBrf0193607]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00040037 ! inferior neuropils (Drosophila)

[Term]
id: FBbt:00045040
name: superior posterior slope (Drosophila)
def: "Superior (dorsal) part of the posterior slope. It lies behind the great commissure, gorget and vest and below the inferior clamp and inferior bridge. It has no clear glial boundary with the surrounding neuropils." [FlyBase:FBrf0224194]
synonym: "SPS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "spsl" RELATED [FlyBase:FBrf0193607]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00040072 ! posterior slope (Drosophila)

[Term]
id: FBbt:00045046
name: inferior posterior slope (Drosophila)
def: "Inferior (ventral) part of the posterior slope. It flanks both sides of the esophagus, and is posterior and medial to the wedge. Below the plane of the inferior VLP commissure and the posterior optic commissure." [FlyBase:FBrf0224194]
synonym: "IPS" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "psl" RELATED [FlyBase:FBrf0193607]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00040072 ! posterior slope (Drosophila)

[Term]
id: FBbt:00045047
name: periesophageal neuropils (Drosophila)
def: "Group of synaptic neuropil domains in the adult brain located between the antennal lobe/ventromedial neuropils and above the gnathal ganglia. In addition, it includes one synaptic domain that is part of the ventral cerebral ganglion-the prow." [FlyBase:FBrf0224194]
synonym: "PENP" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6041000 ! synaptic neuropil block
relationship: part_of UBERON:6110636 ! adult cerebral ganglion

[Term]
id: FBbt:00045048
name: saddle (Drosophila)
def: "Synaptic neuropil domain covering the dorsal and posterior surface of the gnathal ganglia. It contains the antennal mechanosensory and motor center (AMMC)." [FlyBase:FBrf0224194, VFB_vol:00045048]
synonym: "SAD" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
relationship: part_of FBbt:00007146 ! adult deutocerebrum (Drosophila)
relationship: part_of FBbt:00045047 ! periesophageal neuropils (Drosophila)
relationship: part_of FBbt:00110639 ! adult subesophageal zone (Drosophila)

[Term]
id: FBbt:00045050
name: flange (Drosophila)
def: "A small, bilaterally paired, triangular synaptic neuropil domain that lies above the anterior end of the saddle, on both sides of the esophagus. It lies at the root of the median bundle, behind the prow." [FlyBase:FBrf0224194, VFB_vol:00045050]
synonym: "FLA" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00007146 ! adult deutocerebrum (Drosophila)
relationship: part_of FBbt:00045047 ! periesophageal neuropils (Drosophila)

[Term]
id: FBbt:00045051
name: cantle (Drosophila)
def: "A small, bilaterally paired, triangular synaptic neuropil domain that lies at the posterior end of the saddle. It is clearly demarcated by glial boundaries." [FlyBase:FBrf0224194, VFB_vol:00045051]
synonym: "CAN" EXACT BRAIN_NAME_ABV [FlyBase:FBrf0224194]
synonym: "PONPp" EXACT [FlyBase:FBrf0224194]
synonym: "posterior perioesophageal neuropil" EXACT [FlyBase:FBrf0224194]
is_a: UBERON:6040007 ! synaptic neuropil domain
relationship: part_of FBbt:00007146 ! adult deutocerebrum (Drosophila)
relationship: part_of FBbt:00045047 ! periesophageal neuropils (Drosophila)

