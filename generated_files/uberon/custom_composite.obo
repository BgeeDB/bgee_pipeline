is_a: UBERON:0007702 ! tract of brain
relationship: part_of UBERON:6110636 ! adult cerebral ganglion

[Term]
id: FBbt:00007087
name: embryonic/larval cardial valve (Drosophila)
def: "A deep fold of the posterior-most part of the foregut epithelium that is part of the embryonic/larval proventriculus (cardia). It consists of a short neck and a blunt conical head, with the esophageal lumen opening at its apex. It is composed from the two inner layers of the proventriculus." [FlyBase:FBrf0007735, FlyBase:FBrf0048518, FlyBase:FBrf0064792]
synonym: "gastric valve" EXACT [FlyBase:FBrf0064792]
synonym: "larval cardial valve" EXACT []
relationship: part_of FBbt:00001882 ! embryonic/larval midgut (Drosophila)

[Term]
id: FBbt:00007088
name: neural lamella (Drosophila)
def: "Acellular sheath which forms the outermost layer of the central nervous system. It consists, in part, of a matrix of 'collagen-like' fibers and is invaded by tracheoles." [FlyBase:FBrf0058936, ISBN:978-0-7204-7136-6]
is_a: UBERON:0000476 ! acellular anatomical structure
relationship: part_of UBERON:0001017 ! central nervous system

[Term]
id: FBbt:00007089
