def: "A surface associated glial cell that is associated with the exit point of a nerve from the central nervous system." [FBC:DOS]
is_a: FBbt:00001252 ! surface associated glial cell (Drosophila)
is_a: FBbt:00001327 ! peripheral glial cell (Drosophila)

[Term]
id: FBbt:00001255
name: channel glial cell (Drosophila)
def: "Surface associated glial cell that lies along the dorsoventral channels of the ventral nerve cord. The cell bodies lie close to and send processes along the channel surface. The nuclei of these glial cells are smaller and more spherical compared to the flattened nuclei of the subperineurial glia." [FlyBase:FBrf0082171]
synonym: "CG" EXACT [FlyBase:FBrf0082171]
synonym: "CNS channel glial cell" EXACT []
is_a: FBbt:00001251 ! embryonic/larval glial cell (Drosophila)
is_a: FBbt:00001252 ! surface associated glial cell (Drosophila)
