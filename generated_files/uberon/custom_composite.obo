property_value: external_definition "Paired, intramembranous bone located on the lateral sides of the skull, posterior to the premaxillae.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0000285", ontology="AAO", source="AAO:LAP"}
