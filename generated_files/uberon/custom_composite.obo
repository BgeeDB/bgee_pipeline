id: FBbt:00003178
name: wing pulsatile organ 1 (Drosophila)
def: "." [FlyBase:FBrf0031012]
is_a: FBbt:00003177 ! wing pulsatile organ (Drosophila)

[Term]
id: FBbt:00003179
name: wing pulsatile organ 2 (Drosophila)
def: "." [FlyBase:FBrf0031012]
is_a: FBbt:00003177 ! wing pulsatile organ (Drosophila)

[Term]
id: FBbt:00003180
name: wing pulsatile organ 3 (Drosophila)
def: "." [FlyBase:FBrf0031012]
is_a: FBbt:00003177 ! wing pulsatile organ (Drosophila)

[Term]
id: FBbt:00003181
name: wing pulsatile organ 4 (Drosophila)
def: "." [FlyBase:FBrf0031012]
