relationship: develops_from FBbt:00100176 ! pupal Pdf neuron close to tritocerebrum (Drosophila)
relationship: part_of UBERON:6003624 ! adult brain

[Term]
id: FBbt:00003767
name: distal medullary amacrine neuron (Drosophila)
def: "An amacrine neuron that is intrinsic to the medulla, whose soma is located in the cortex of the medulla and that branches and arborizes in the distal medulla. These neurons project through the distal surface of the medulla, to form wide (sometimes very wide) terminal arborizations mainly or completely restricted to a single layer of the medulla." [FlyBase:FBrf0049410]
synonym: "Dm" RELATED []
is_a: CL:0000402 ! CNS interneuron
is_a: CL:0000561 ! amacrine cell
relationship: part_of FBbt:00003748 ! medulla (Drosophila)

[Term]
id: FBbt:00003768
name: distal medullary amacrine neuron Dm1 (Drosophila)
def: "Distal medullary wide-field amacrine neuron that branches extensively at the distal surface of the medulla forming a moderately broad arbor with each branch making a distinctive bleb-type terminal in M1 from which short, fine terminal branches project (Morante and Desplan, 2008; Fischbach and Dittrich, 1989)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652]
synonym: "Dm1" EXACT [FlyBrain_NDB:10081]
is_a: FBbt:00003767 ! distal medullary amacrine neuron (Drosophila)

[Term]
id: FBbt:00003769
name: distal medullary amacrine neuron Dm2 (Drosophila)
def: "Distal medullary wide-field amacrine neuron that terminates with a bushy arbor with mixed terminal morphology in layers M4-6 (Morante and Desplan, 2008; Fischbach and Dittrich, 1989)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652]
synonym: "Dm2" EXACT [FlyBrain_NDB:10082]
is_a: FBbt:00003767 ! distal medullary amacrine neuron (Drosophila)
is_a: FBbt:00110137 ! wide-field columnar neuron (Drosophila)

[Term]
id: FBbt:00003770
name: distal medullary amacrine neuron Dm3 (Drosophila)
def: "Distal medullary wide-field amacrine neuron that projects asymmetrically along layers M2 and M3 forming mixed morphology arborizations (Morante and Desplan, 2008; Fischbach and Dittrich, 1989). It is a glutamatergic neuron (Raghu and Borst, 2011)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652, FlyBase:FBrf0213690]
synonym: "Dm3" EXACT [FlyBrain_NDB:10083]
is_a: FBbt:00003767 ! distal medullary amacrine neuron (Drosophila)
is_a: FBbt:00100291 ! glutamatergic neuron (Drosophila)

[Term]
id: FBbt:00003771
name: distal medullary amacrine neuron Dm4 (Drosophila)
def: "Distal medullary wide-field amacrine neuron that projects asymmetrically along layers M5 and 6 forming mixed morphology arborizations (Morante and Desplan, 2008; Fischbach and Dittrich, 1989). Some collaterals from this projection along M5-6 project back to M4 where they form distinctive terminal blebs (Fischbach and Dittrich, 1989)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652]
synonym: "Dm4" EXACT [FlyBrain_NDB:10084]
is_a: FBbt:00003767 ! distal medullary amacrine neuron (Drosophila)
is_a: FBbt:00110137 ! wide-field columnar neuron (Drosophila)

[Term]
id: FBbt:00003772
name: distal medullary amacrine neuron Dm5 (Drosophila)
def: "Distal medullary wide-field amacrine neuron that has a moderately broad, fine terminal arborization in layers M4-6. It is a glutamatergic neuron (Raghu and Borst, 2011)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652, FlyBase:FBrf0213690]
synonym: "Dm5" EXACT [FlyBrain_NDB:10085]
is_a: FBbt:00003767 ! distal medullary amacrine neuron (Drosophila)
is_a: FBbt:00100291 ! glutamatergic neuron (Drosophila)
is_a: FBbt:00110137 ! wide-field columnar neuron (Drosophila)

[Term]
id: FBbt:00003773
name: distal medullary amacrine neuron Dm6 (Drosophila)
def: "Distal medullary wide-field amacrine neuron that branches extensively at the distal surface of the medulla forming a broad arbor with each branch making a distinctive bleb-type terminal in layer M1 from which short, fine terminal branches project (Morante and Desplan, 2008; Fischbach and Dittrich, 1989). The arborizations in M1 are enriched in presynaptic terminals (Morante and Desplan, 2008)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652]
synonym: "Dm6" EXACT [FlyBrain_NDB:10086]
is_a: FBbt:00003767 ! distal medullary amacrine neuron (Drosophila)

[Term]
id: FBbt:00003774
name: distal medullary amacrine neuron Dm7 (Drosophila)
def: "Distal medullary amacrine neuron that branches in layer M6. The branches spread along the layer, forming an arbor in M6 with terminals of mixed morphology. Some collaterals from this arbor extend to M4 where they also spread to form an arbor with terminals of mixed morphology." [FlyBase:FBrf0049410]
synonym: "Dm7" EXACT [FlyBase:FBrf0049410, FlyBrain_NDB:10087]
is_a: FBbt:00003767 ! distal medullary amacrine neuron (Drosophila)
is_a: FBbt:00110137 ! wide-field columnar neuron (Drosophila)

[Term]
id: FBbt:00003775
name: medullary intrinsic neuron (Drosophila)
def: "A columnar neuron whose cell body lies in the medulla cortex and that is intrinsic to the medulla." [FlyBase:FBrf0049410]
synonym: "Mi" RELATED []
is_a: FBbt:00007578 ! intrinsic columnar neuron (Drosophila)

[Term]
id: FBbt:00003776
name: medullary intrinsic neuron Mi1 (Drosophila)
def: "Medullary intrinsic narrow field neuron with bushy, fine arborizations in medulla layers M1, M3 and M5, coinciding with the arborization domains of lamina monopolar neuron L1. The projection of this neuron branches at the inner-face of the medulla to form two to three varicose recurrent terminal specializations that extend back up to the inner border of layer M8 (Morante and Desplan, 2008; Fischbach and Dittrich, 1989). Pre-synaptic terminals are present in medulla layers M9-M10. It is a cholinergic neuron (Hasegawa et al., 2011)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652, FlyBase:FBrf0213020]
synonym: "medullary intrinsic neuron 1" EXACT []
synonym: "Mi1" EXACT [FlyBrain_NDB:10097]
synonym: "small field unilateral tristratified neuron" RELATED []
synonym: "Sut" RELATED []
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)
is_a: FBbt:00007173 ! cholinergic neuron (Drosophila)
is_a: FBbt:00110136 ! narrow field columnar neuron (Drosophila)

[Term]
id: FBbt:00003777
name: medullary intrinsic neuron Mi2 (Drosophila)
def: "Medullary intrinsic neuron with both fine and bleb-type arborizations in medulla layers M1, M2 and M3, but with only fine arborizations in medulla layers M4, M5, M8 and M9. It is a cholinergic neuron (Varija Raghu et al., 2011)." [FlyBase:FBrf0049410, FlyBase:FBrf0212356]
synonym: "Mi2" EXACT [FlyBrain_NDB:10101]
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)
is_a: FBbt:00007173 ! cholinergic neuron (Drosophila)

[Term]
id: FBbt:00003778
name: medullary intrinsic neuron Mi3 (Drosophila)
def: "Medullary intrinsic wide-field neuron with both fine and bleb-type arborizations in medulla layers M3, M6 and M8, but with only fine arborizations in medulla layer M9 (Morante and Desplan, 2008; Fischbach and Dittrich, 1989)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652]
synonym: "Mi3" EXACT [FlyBrain_NDB:10102]
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)
is_a: FBbt:00110137 ! wide-field columnar neuron (Drosophila)

[Term]
id: FBbt:00003779
name: medullary intrinsic neuron Mi4 (Drosophila)
def: "Medullary intrinsic narrow field neuron with both fine and bleb-type arborizations in medulla layers M1, M2, M3 and M8, but with only fine arborizations in medulla layers M4 and M5, and only bleb-type arborizations in medulla layer M9 (Morante and Desplan, 2008; Fischbach and Dittrich, 1989). It is a glutamatergic neuron (Raghu and Borst, 2011)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652, FlyBase:FBrf0213690]
synonym: "Mi4" EXACT [FlyBrain_NDB:10103]
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)
is_a: FBbt:00100291 ! glutamatergic neuron (Drosophila)
is_a: FBbt:00110136 ! narrow field columnar neuron (Drosophila)

[Term]
id: FBbt:00003780
name: medullary intrinsic neuron Mi5 (Drosophila)
def: "Medullary intrinsic narrow field neuron with both fine and bleb-type arborizations in medulla layer M8 and the serpentine layer, but with only fine arborizations in medulla layer M6 (Morante and Desplan, 2008; Fischbach and Dittrich, 1989)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652]
synonym: "Mi5" EXACT [FlyBrain_NDB:10104]
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)
is_a: FBbt:00110136 ! narrow field columnar neuron (Drosophila)

[Term]
id: FBbt:00003781
name: medullary intrinsic neuron Mi6 (Drosophila)
def: "Medullary intrinsic neuron with both fine and bleb-type arborizations in medulla layers M2, M5, M6 and M8, but with only fine arborizations in medulla layers M3 and M4." [FlyBase:FBrf0049410]
synonym: "Mi6" RELATED [FlyBrain_NDB:10105]
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)

[Term]
id: FBbt:00003782
name: medullary intrinsic neuron Mi7 (Drosophila)
def: "Medullary intrinsic neuron with both fine and bleb-type arborizations in medulla layer M6, but with only fine arborizations in medulla layers M1, M3, M5 and M8. It is a cholinergic neuron (Varija Raghu et al., 2011)." [FlyBase:FBrf0049410, FlyBase:FBrf0212356]
synonym: "Mi7" EXACT [FlyBrain_NDB:10106]
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)
is_a: FBbt:00007173 ! cholinergic neuron (Drosophila)

[Term]
id: FBbt:00003783
name: medullary intrinsic neuron Mi8 (Drosophila)
def: "Medullary intrinsic neuron with a bushy mix of bleb-type and fine terminal arborization in layers M1-3. The projection of this neuron branches at the boundary with M10 to form varicose recurrent terminal specializations that extend back through M9." [FlyBase:FBrf0049410, FlyBase:FBrf0220286]
synonym: "Mi8" EXACT [FlyBrain_NDB:10107]
is_a: CL:0011005 ! GABAergic interneuron
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)
is_a: FBbt:00007228 ! GABAergic neuron (Drosophila)

[Term]
id: FBbt:00003784
name: medullary intrinsic neuron Mi9 (Drosophila)
def: "Medullary intrinsic narrow field neuron with a bushy mix of bleb-type and fine terminal arborization in layers M2, M3 and M4 and in the lower medulla layers M9-M10. It establishes pre- and post-synaptic connections in both the inner and outer medulla layers (Morante and Desplan, 2008; Fischbach and Dittrich, 1989)." [FlyBase:FBrf0049410, FlyBase:FBrf0204652]
synonym: "Mi9" EXACT [FlyBrain_NDB:10108]
is_a: FBbt:00003775 ! medullary intrinsic neuron (Drosophila)
is_a: FBbt:00110136 ! narrow field columnar neuron (Drosophila)

