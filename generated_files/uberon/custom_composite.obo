synonym: "external mandibular levator muscle" EXACT []
synonym: "mlme" EXACT []
is_a: XAO:0004323 ! mandibular head muscle (Xenopus)
relationship: develops_from XAO:0004429 ! m. levator mandibulae externus primordium (Xenopus)

