property_value: external_definition "A tuft of capillaries found in a Bowman's capsule in which waste products are filtered from the blood and urine formation is initiated.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0010388", ontology="AAO", source="AAO:BJB"}
