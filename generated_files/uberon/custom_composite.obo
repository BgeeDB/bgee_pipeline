is_a: UBERON:6007245 ! cuticular specialization
relationship: part_of FBbt:00004660 ! unguis (Drosophila)

[Term]
id: FBbt:00004662
name: retineria (Drosophila)
def: "Tiny hollow hairs on the distal pretarsus (foot) through which viscous substances are secreted." [FlyBase:FBrf0166419]
is_a: UBERON:6007245 ! cuticular specialization
relationship: part_of FBbt:00004653 ! pretarsus (Drosophila)

[Term]
id: FBbt:00004664
