[Term]
id: FBbt:00004053
name: cervical nerve (Drosophila)
def: "A bilaterally paired nerve that connects laterally to the cervical connective immediately posterior to where it enters the thorax. Each cervical nerve extends laterally, branching and innervating horizontal muscles of the anterior thorax." [FlyBase:FBrf0007196]
synonym: "CvN" EXACT [FlyBase:FBrf0007196]
synonym: "CvNv" EXACT [FlyBase:FBrf0186027]
