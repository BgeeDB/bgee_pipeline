[Term]
id: CL:0000740
name: retinal ganglion cell
namespace: cell
def: "The set of neurons that receives neural inputs via bipolar, horizontal and amacrine cells. The axons of these cells make up the optic nerve." []
synonym: "gangliocyte" EXACT []
synonym: "ganglion cell of retina" EXACT []
synonym: "RGC" EXACT []
xref: BTO:0001800
xref: FMA:67765
xref: ZFA:0009310
