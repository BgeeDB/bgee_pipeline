is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00111008
name: mushroom body output neuron 10 (Drosophila)
def: "A GABAergic neuron whose dendrites arborize in beta' lobe slice 1, and in neighboring neuropils including crepine, superior medial and intermediate protocerebrum. Axonal terminals are found in the lateral accessory lobe. There are around 7-9 neurons of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-10" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-beta'1" EXACT [FlyBase:FBrf0227179]
is_a: CL:0011005 ! GABAergic interneuron
is_a: FBbt:00007228 ! GABAergic neuron (Drosophila)
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00111009
name: mushroom body output neuron 12 (Drosophila)
def: "A cholinergic neuron whose dendrites arborize in gamma lobe slice 2 and alpha' lobe slice 1 with axonal terminals found in the crepine and superior medial protocerebrum. There are 2 neurons of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-12" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-gamma2alpha'1" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00007173 ! cholinergic neuron (Drosophila)
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00111010
name: mushroom body output neuron 15 (Drosophila)
def: "A cholinergic neuron whose dendrites arborize unilaterally in alpha' lobe slice 1. The thin dendritic branches project through the edge of the alpha' lobe slices 2 and 3 compartments to the contralateral hemisphere, sharing an axon tract with MB-V2 alpha'. Axon terminals are found in the superior intermediate and lateral protocerebrum, and lateral horn. There are 2 neurons of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-15" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-alpha'1" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00007173 ! cholinergic neuron (Drosophila)
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00111011
name: mushroom body output neuron 19 (Drosophila)
def: "A cholinergic neuron whose dendrites arborize unilaterally in the posterior layer of alpha lobe slices 2 and 3 and projects to the superior medial protocerebrum. There are 2 neurons of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-19" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-alpha2p3p" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00007173 ! cholinergic neuron (Drosophila)
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00111012
name: mushroom body output neuron 2 (Drosophila)
def: "A glutamatergic neuron whose dendrites arborize bilaterally in the beta lobe slice 2 and anterior layer of beta' lobe slice 2. Its axon projects ipsilaterally to the superior intermediate and lateral protocerebrum. There is one neuron of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-02" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-beta2beta'2a" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)
is_a: FBbt:00100291 ! glutamatergic neuron (Drosophila)

[Term]
id: FBbt:00111013
name: mushroom body output neuron 20 (Drosophila)
def: "A neuron whose dendrites arborize in gamma lobe slices 1 and 2. There is 1 neuron of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "MBON-20" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-gamma1gamma2" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00111014
name: mushroom body output neuron 4 (Drosophila)
def: "Glutamatergic neuron whose cell body is located on the superior neuropils of each hemisphere, anterior to the pars intercerebralis. The cell body fiber is sent ventrally towards the medial lobe, crossing the midline. Dendritic arborizations are found in the anterior and posterior layers of beta' lobe slice 2, with the main axon projecting bilaterally to the crepine and superior medial protocerebrum." [FlyBase:FBrf0227179]
synonym: "MBON-04" EXACT [FlyBase:FBrf0227179]
synonym: "MBON-beta'2mp_bilateral" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)
is_a: FBbt:00100291 ! glutamatergic neuron (Drosophila)
relationship: part_of UBERON:6003624 ! adult brain

[Term]
id: FBbt:00111015
name: dopaminergic PAM neuron 1 (Drosophila)
def: "Dopaminergic neuron of the PAM cluster whose dendrites arborize the superior medial protocerebrum. The axon projects to the gamma lobe slice 5. There are around 8-21 neurons of this type in each hemisphere." [FlyBase:FBrf0227179]
synonym: "PAM-01" EXACT [FlyBase:FBrf0227179]
synonym: "PAM-gamma5" EXACT [FlyBase:FBrf0227179]
is_a: FBbt:00100214 ! dopaminergic PAM neuron (Drosophila)
