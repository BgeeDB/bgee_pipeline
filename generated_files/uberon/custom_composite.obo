synonym: "inferior nasal turbinate bone" EXACT []
synonym: "inferior turbinate" EXACT [FMA:54736]
synonym: "inferior turbinated" RELATED [http://en.wikipedia.org/wiki/Inferior_nasal_concha]
synonym: "maxilloturbinal" RELATED [http://palaeos.com/vertebrates/bones/braincase/ethmoid.html]
