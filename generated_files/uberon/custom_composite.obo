subset: upper_level
synonym: "cell part cluster" RELATED [FMA:83115]
synonym: "multi-cell-component structure" EXACT [CARO:0001000]
synonym: "multi-cell-part structure" EXACT [CARO:0001000]
xref: AAO:0011000
xref: CARO:0001000
xref: FBbt:00007060
xref: FMA:83115
