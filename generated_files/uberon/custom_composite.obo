synonym: "decussation of lemniscus" EXACT [FMA:72622]
synonym: "decussation of medial lemnisci" EXACT [FMA:72622]
synonym: "decussation of the medial lemniscus" RELATED [NeuroNames:788]
synonym: "medial lemniscus decussation" EXACT [FMA:72622]
synonym: "medullary sensory decussation" EXACT [FMA:72622]
synonym: "sensory decussation" EXACT [FMA:72622]
