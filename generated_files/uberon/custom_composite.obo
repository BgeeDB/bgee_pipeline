name: wing pulsatile organ 5 (Drosophila)
def: "." [FlyBase:FBrf0031012]
is_a: FBbt:00003177 ! wing pulsatile organ (Drosophila)

[Term]
id: FBbt:00003183
name: adult garland cell (Drosophila)
def: "Any garland cell (FBbt:00005059) that is part of some adult (FBbt:00003004)." [FBC:auto_generated_definition, FlyBase:FBrf0031012]
synonym: "nephrocyte" RELATED []
is_a: CL:0000486 ! garland cell
relationship: part_of FBbt:00003149 ! adult circulatory system (Drosophila)

[Term]
id: FBbt:00003184
name: adult pericardial cell (Drosophila)
def: "A discrete, large, ovoid cell attached to the dorsal diaphragm in the abdomen and near the anterior end of the ventriculus in the thorax. Some of these cells are binucleate." [FlyBase:FBrf0007735]
synonym: "nephrocyte" EXACT [FlyBase:FBrf0007735]
synonym: "Nph" EXACT [FlyBase:FBrf0007735]
synonym: "PCl" EXACT [FlyBase:FBrf0007735]
is_a: CL:0000474 ! pericardial nephrocyte
relationship: part_of FBbt:00003149 ! adult circulatory system (Drosophila)

[Term]
id: FBbt:00003185
name: adult oenocyte (Drosophila)
def: "Large, acidophilic cell found in rows under the epidermis of each abdominal segment. Two dorsal rows run from the heart tube to the spiracle, close to the posterior boundary of the segment. A single, or sometimes split, transverse row is found under each sternite." [FlyBase:FBrf0007735]
is_a: CL:0000487 ! oenocyte
relationship: part_of FBbt:00007317 ! adult oenocyte band (Drosophila)

[Term]
id: FBbt:00003186
name: dorsal adult oenocyte band (Drosophila)
is_a: FBbt:00007317 ! adult oenocyte band (Drosophila)

