[Term]
id: UBERON:8000004
name: central retina
namespace: uberon
def: "Region of retina around the fovea that extends approximately for 6 mm. Central retina is considerably thick due to increased density of photoreceptors, particularly cones and their associated bipolar and ganglion cells." [https://webvision.med.utah.edu/book/part-i-foundations/simple-anatomy-of-the-retina/]
is_a: UBERON:0000073 ! regional part of nervous system
relationship: part_of UBERON:0000966 ! retina
created_by: http://orcid.org/0000-0001-5208-3432

[Term]
id: UBERON:8000005
