[Term]
id: UBERON:0010195
name: renal portal system
namespace: uberon
def: "A portal system that transports blood returning from capillary beds within tail or hindlimbs through paired renal portal veins that empty into capillaries within the kidneys." [ISBN:0073040584]
synonym: "portal system of kidney" EXACT []
synonym: "renal-portal system" EXACT [AAO:0010518]
xref: AAO:0010518
is_a: UBERON:0005806 ! portal system
property_value: external_definition "Part of the circulatory system in which the veins of the hindlimb combine to form the pair Jacobson's veins which receive many small vesicles from the kidney and also collects blood from the oviducal vein.[AAO]" xsd:string {date_retrieved="2012-06-20", external_class="AAO:0010518", ontology="AAO", source="AAO:BJB"}
property_value: function_notes "function not well understood" xsd:string
property_value: taxon_notes "present in all classes of vertebrates except mammals; the mammalian kidney has a low pressure vascular network that may be its counterpart" xsd:string {source="ISBN:0073040584"}

