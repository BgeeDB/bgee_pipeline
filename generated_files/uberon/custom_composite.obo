def: "A neuroblast located in the deutocerebrum." [FlyBase:FBrf0089217, FlyBase:FBrf0161021]
synonym: "deuterocerebral neuroblast" EXACT []
is_a: FBbt:00001332 ! embryonic neuroblast (Drosophila)
is_a: FBbt:00001333 ! procephalic neuroblast (Drosophila)
relationship: part_of FBbt:00003923 ! deutocerebrum (Drosophila)

[Term]
id: FBbt:00001354
name: dorsal deutocerebral neuroblast (Drosophila)
def: "A neuroblast located in the dorsal region of the deutocerebrum." [FlyBase:FBrf0089217, FlyBase:FBrf0161021]
synonym: "Da" RELATED []
synonym: "dorsal deuterocerebral neuroblast" EXACT []
is_a: FBbt:00001353 ! deutocerebral neuroblast (Drosophila)

[Term]
id: FBbt:00001356
name: ventral deutocerebral neuroblast (Drosophila)
def: "A neuroblast located in the ventral region of the deutocerebrum." [FlyBase:FBrf0089217, FlyBase:FBrf0161021]
synonym: "Dc" RELATED []
synonym: "ventral deuterocerebral neuroblast" EXACT []
is_a: FBbt:00001353 ! deutocerebral neuroblast (Drosophila)

[Term]
id: FBbt:00001363
name: tritocerebral neuroblast (Drosophila)
def: "A neuroblast located in the tritocerebrum." [FlyBase:FBrf0089217, FlyBase:FBrf0161021]
synonym: "T" RELATED []
is_a: FBbt:00001332 ! embryonic neuroblast (Drosophila)
is_a: FBbt:00001333 ! procephalic neuroblast (Drosophila)
relationship: part_of FBbt:00003999 ! tritocerebrum (Drosophila)

[Term]
id: FBbt:00001366
name: supraesophageal ganglion neuron (Drosophila)
def: "Neuron located in the supraesophageal ganglion." [FBC:SPR]
is_a: CL:2000029 ! central nervous system neuron
relationship: part_of UBERON:6003626 ! supraesophageal ganglion

[Term]
id: FBbt:00001367
name: SP1 neuron (Drosophila)
def: "Bilaterally paired neuron of the embryo/larva. Each (?) abdominal segment contains a pair of SP1 neurons with an axon that crosses the ventral midline as part of the anterior commissure, wraps around the cell body of its contralateral partner and then extends anteriorly as part of the longitudinal connective. During development, these axons pioneer the anterior commissure and longitudinal connectives." [FlyBase:FBrf0053374, FlyBase:FBrf0064795, FlyBase:FBrf0144965]
is_a: CL:0000116 ! pioneer neuron
is_a: CL:2000029 ! central nervous system neuron

[Term]
id: FBbt:00001368
name: serotonergic SP2 neuron (Drosophila)
def: "Serotonergic neuron whose cell body is located in the in the anterodorsal brain. There is a cluster of neurons in each hemisphere, with four neurons in each cluster." [FlyBase:FBrf0048551]
synonym: "SP2 neuron" EXACT [FlyBase:FBrf0048551]
synonym: "supraesophageal ganglion neuron 2" EXACT [FlyBase:FBrf0048551]
is_a: FBbt:00100359 ! serotonergic SP neuron (Drosophila)

[Term]
id: FBbt:00001369
name: neuroblast of ventral nerve cord primordium (Drosophila)
def: "Any neuroblast (FBbt:00005146) that is part of some ventral nerve cord primordium (FBbt:00005554)." [FBC:auto_generated_definition, FlyBase:FBrf0090460, FlyBase:FBrf0098344]
synonym: "neuroblast of ventral nervous system" RELATED []
is_a: FBbt:00001332 ! embryonic neuroblast (Drosophila)
relationship: part_of FBbt:00005554 ! ventral nerve cord primordium (Drosophila)

[Term]
id: FBbt:00001370
name: stage 1 neuroblast (Drosophila)
def: "The first neuroblast subpopulation delaminating from the ventral neurectoderm towards the end of the second mesodermal cell division, shortly after gastrulation (Hartenstein and Campos-Ortega, 1984). These neuroblasts are generally arranged in two fairly regular longitudinal rows (the medial and lateral longitudinal rows), with a few cells scattered in an intermediate row. Doe (1992) defines the end of S1 as being early embryonic stage 9 following the development of NB3-2." [FlyBase:FBrf0055900, FlyBase:FBrf0073294, FlyBase:FBrf0076117, FlyBase:FBrf0112030, http://uoneuro.uoregon.edu/doelab/nbmap.html]
synonym: "S1 neuroblast" RELATED []
synonym: "SI neuroblast" RELATED []
is_a: FBbt:00001369 ! neuroblast of ventral nerve cord primordium (Drosophila)

[Term]
id: FBbt:00001371
name: neuroblast NB1-1 (Drosophila)
def: "Neuroblast NB1-1 delaminates at stage 1 and generates the aCC and pCC neurons, glia, interneurons and additional motorneurons in the thoracic segments (http://www.neuro.uoregon.edu/doelab/lineages/NB1-1.html)." [FlyBase:FBrf0055900, FlyBase:FBrf0058118, FlyBase:FBrf0073294, FlyBase:FBrf0084809, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB1-1.html]
synonym: "NB2-2" RELATED [FlyBase:FBrf0084809]
synonym: "neuroglioblast NB1-1" EXACT [FlyBase:FBrf0058118]
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001372
name: neuroblast NB1-1 of thorax (Drosophila)
is_a: FBbt:00001371 ! neuroblast NB1-1 (Drosophila)
is_a: FBbt:00003561 ! thoracic neuroblast (Drosophila)
relationship: part_of FBbt:00005387 ! embryonic nervous system of thorax (Drosophila)

[Term]
id: FBbt:00001373
name: neuroblast NB1-1 of abdomen (Drosophila)
is_a: CL:0000468 ! neuroglioblast (sensu Nematoda and Protostomia)
is_a: FBbt:00001371 ! neuroblast NB1-1 (Drosophila)
is_a: FBbt:00003584 ! abdominal neuroblast (Drosophila)
relationship: part_of FBbt:00005388 ! embryonic nervous system of abdomen (Drosophila)

[Term]
id: FBbt:00001374
name: neuroblast NB2-5 (Drosophila)
def: "Neuroblast NB2-5 delaminates at S1 and generates a diverse array of cell types including motorneurons, intersegmental interneurons, local interneurons, glial cells and sometimes a PNS sub-clone (http://www.neuro.uoregon.edu/doelab/lineages/NB2-5.html)." [FlyBase:FBrf0055900, FlyBase:FBrf0073294, FlyBase:FBrf0084809, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB2-5.html]
is_a: CL:0000468 ! neuroglioblast (sensu Nematoda and Protostomia)
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001375
name: neuroblast NB3-5 (Drosophila)
def: "Neuroblast NB3-5 delaminates at stage 1 in the interior-most row of the lateral column (Hartenstein and Campos-Ortega, 1984), and generates a diverse array of cell types including motorneurons, intersegmental interneurons, local interneurons, glial cells and sometimes a PNS sub-clone (http://www.neuro.uoregon.edu/doelab/lineages/NB3-5.html)." [FlyBase:FBrf0055900, FlyBase:FBrf0073294, FlyBase:FBrf0084809, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB3-5.html]
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001376
name: neuroblast NB5-2 (Drosophila)
def: "Neuroblast NB5-2 delaminates at stage 1 in the medial column (Hartenstein and Campos-Ortega, 1984). It generates a single motorneuron innervating muscle 12 via the SNb and a large number of intersegmental and local interneurons. Most of the posterior commissure derives from NB5-2 interneurons (http://www.neuro.uoregon.edu/doelab/lineages/NB5-2.html). In the third instar larva, the lineage originated by this neuroblast is located in the medial region." [FlyBase:FBrf0055900, FlyBase:FBrf0073294, FlyBase:FBrf0076117, FlyBase:FBrf0084809, FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB5-2.html]
synonym: "medial SI neuroblast NB 5-2" RELATED []
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001377
name: neuroblast NB5-6 (Drosophila)
def: "Neuroblast NB5-6 generates lateral sub-perineural glial cells and interneurons (http://www.neuro.uoregon.edu/doelab/lineages/NB5-6.html)." [FlyBase:FBrf0055900, FlyBase:FBrf0073294, FlyBase:FBrf0084809, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB5-6.html]
is_a: CL:0000468 ! neuroglioblast (sensu Nematoda and Protostomia)
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001378
name: neuroblast NB5-6 of thorax (Drosophila)
def: "Neuroblast NB5-6 of the thorax that delaminates at late stage 8 in the lateral column. It generates 10 to 14 interneurons and 3 to 5 glial cells. It exits the cell cycle at stage 15 and dies via apoptosis at stage 16." [FlyBase:FBrf0098344, FlyBase:FBrf0112030, FlyBase:FBrf0209429]
synonym: "NB 5-6T" EXACT [FlyBase:FBrf0098344]
synonym: "NB5-6T" EXACT []
is_a: FBbt:00001377 ! neuroblast NB5-6 (Drosophila)
is_a: FBbt:00003561 ! thoracic neuroblast (Drosophila)
relationship: part_of FBbt:00005387 ! embryonic nervous system of thorax (Drosophila)

[Term]
id: FBbt:00001379
name: neuroblast NB5-6 of abdomen (Drosophila)
def: "Neuroblast NB5-6 of the abdomen that delaminates at stage 1 in the lateral column. It generates 3 to 5 interneurons and 2 to 6 glial cells." [FlyBase:FBrf0098344, FlyBase:FBrf0112030]
synonym: "NB 5-6A" EXACT [FlyBase:FBrf0098344]
synonym: "NB5-6A" EXACT []
is_a: FBbt:00001377 ! neuroblast NB5-6 (Drosophila)
is_a: FBbt:00003584 ! abdominal neuroblast (Drosophila)
relationship: part_of FBbt:00005388 ! embryonic nervous system of abdomen (Drosophila)

[Term]
id: FBbt:00001380
name: neuroblast NB7-1 (Drosophila)
def: "Neuroblast NB7-1 is the largest neuroblast lineage generating 40 cells or more, including the U motorneurons and a large number of local interneurons. It also frequently generates the putative segment boundary cells (http://www.neuro.uoregon.edu/doelab/lineages/NB7-1.html). In the third instar larva, the lineage originated by this neuroblast is located at the posterior border neuromere." [FlyBase:FBrf0055900, FlyBase:FBrf0073294, FlyBase:FBrf0084809, FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB7-1.html]
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001381
name: neuroblast NB7-4 (Drosophila)
def: "Neuroblast NB7-4 generates a large number of glia (http://www.neuro.uoregon.edu/doelab/lineages/NB7-4.html). In the third instar larva, the lineage originated by this neuroblast is located dorsolaterally at the posterior border of the hemineuromere." [FlyBase:FBrf0055900, FlyBase:FBrf0073294, FlyBase:FBrf0084809, FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB7-4.html]
is_a: CL:0000468 ! neuroglioblast (sensu Nematoda and Protostomia)
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001382
name: neuroblast MP2 (Drosophila)
def: "Midline precursor cell that divides only once to produce the intersegmental interneurons dMP2 and vMP2 neurons. Despite its name, it forms bilaterally as part of the medial column of stage1 neuroblasts (Schmid et al., 1999)." [FlyBase:FBrf0055900, FlyBase:FBrf0112030]
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001383
name: stage 2 neuroblast (Drosophila)
def: "A neuroblast delaminating in the second wave of neuroblast delamination from the ventral neuroectoderm. This stage begins in embryonic stage 9 ending in stage 10, and the neuroblasts primarily delaminate into the intermediate column (Doe, 1992)." [FlyBase:FBrf0055900, FlyBase:FBrf0076117]
synonym: "S2 neuroblast" RELATED []
synonym: "SII neuroblast" RELATED []
is_a: FBbt:00001369 ! neuroblast of ventral nerve cord primordium (Drosophila)

[Term]
id: FBbt:00001384
name: neuroblast NB1-2 (Drosophila)
def: "Neuroblast NB1-2 delaminates at S2 and generates 4-6 intersegmental interneurons. It also produces approximately 20 local interneurons and, in the thoracic segments, the semaphorin II (FBgn0011260) positive DC motorneuron (http://www.neuro.uoregon.edu/doelab/lineages/NB1-2.html). In the third instar larva, the lineage originated by this neuroblast is located at the ventro-lateral border of the T1-A1 neuromere." [FlyBase:FBrf0084809, FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB1-2.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/12description.html]
synonym: "NB1-1" RELATED []
synonym: "neuroglioblast 1-1" RELATED []
is_a: FBbt:00001383 ! stage 2 neuroblast (Drosophila)

[Term]
id: FBbt:00001385
name: neuroblast NB2-2 (Drosophila)
def: "Neuroblast NB2-2 delaminates at S2 and generates two to three motorneurons that innervate anterior lateral muscles via the SNa. It generates a large number of local interneurons and a smaller number of late-developing intersegmental interneurons (http://www.neuro.uoregon.edu/doelab/lineages/NB2-2.html)." [FlyBase:FBrf0084809, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB2-2.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/22%20description.html]
synonym: "NB2-3" RELATED []
is_a: FBbt:00001383 ! stage 2 neuroblast (Drosophila)

[Term]
id: FBbt:00001386
name: neuroblast NB2-2 of thorax (Drosophila)
is_a: CL:0000468 ! neuroglioblast (sensu Nematoda and Protostomia)
is_a: FBbt:00001385 ! neuroblast NB2-2 (Drosophila)
is_a: FBbt:00003561 ! thoracic neuroblast (Drosophila)
relationship: part_of FBbt:00005387 ! embryonic nervous system of thorax (Drosophila)

[Term]
id: FBbt:00001387
name: neuroblast NB2-2 of abdomen (Drosophila)
is_a: FBbt:00001385 ! neuroblast NB2-2 (Drosophila)
is_a: FBbt:00003584 ! abdominal neuroblast (Drosophila)
relationship: part_of FBbt:00005388 ! embryonic nervous system of abdomen (Drosophila)

[Term]
id: FBbt:00001388
name: neuroblast NB3-2 (Drosophila)
def: "Neuroblast NB3-2 delaminates at S1 and generates as many as 6 motorneurons and a cluster if local interneurons. It is the mirror image of the clone derived from NB4-2 (http://www.neuro.uoregon.edu/doelab/lineages/NB3-2.html)." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB3-2.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/32%20description.html]
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001389
name: neuroblast NB4-2 (Drosophila)
def: "Neuroblast NB4-2 delaminates at S2 in the intermediate column and produces the well characterized RP2 motorneuron (FBbt:00001453), which innervates muscles 2, 9 and 11. It also produces the Cousins if RP2 motorneurons (CoR), which generate the entirety of the SNc, innervating muscles 26, 27 and 29. It also generates local interneurons and, in a small number of cases, an epidermal subclone (http://www.neuro.uoregon.edu/doelab/lineages/NB4-2.html)." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB4-2.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/42%20description.html]
is_a: FBbt:00001383 ! stage 2 neuroblast (Drosophila)

[Term]
id: FBbt:00001390
name: neuroblast NB5-3 (Drosophila)
def: "Neuroblast NB5-3 delaminates at S1. It generates an SNa motorneuron anteriorly and intersegmental interneurons in every segment (http://www.neuro.uoregon.edu/doelab/lineages/NB5-3.html)." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB5-3.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/53%20description.html]
is_a: FBbt:00001370 ! stage 1 neuroblast (Drosophila)

[Term]
id: FBbt:00001391
name: neuroblast NB6-2 (Drosophila)
def: "Neuroblast NB6-2 delaminates in S2 in the intermediate column. Its lineage contains 8-16 interneurons that project in two bundles across the posterior commissure (http://www.neuro.uoregon.edu/doelab/lineages/NB6-2.html)." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB6-2.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/62%20description.html]
is_a: FBbt:00001383 ! stage 2 neuroblast (Drosophila)

[Term]
id: FBbt:00001392
name: neuroblast NB7-2 (Drosophila)
def: "Neuroblast NB7-2 delaminates at S2 in the intermediate column. Its lineage contains 8-14 interneurons that project either contralaterally in the posterior commissure or ipsilaterally. It is the only neuroblast clone that generates ipsilaterally-projecting intersegmental neurons (http://www.neuro.uoregon.edu/doelab/lineages/NB7-2.html)." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB7-2.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/72%20description.html]
is_a: FBbt:00001383 ! stage 2 neuroblast (Drosophila)

[Term]
id: FBbt:00001393
name: stage 3 neuroblast (Drosophila)
def: "A neuroblast delaminating in the third wave of neuroblast delamination from the ventral neurectoderm. This wave begins during embryonic stage 10 and end during stage 11, and the neuroblasts generally delaminate into the medial and lateral edge of the neuroblast array (Doe, 1992)." [FlyBase:FBrf0055900, FlyBase:FBrf0076117]
synonym: "S3 neuroblast" RELATED []
synonym: "SIII neuroblast" RELATED []
is_a: FBbt:00001369 ! neuroblast of ventral nerve cord primordium (Drosophila)

[Term]
id: FBbt:00001394
name: neuroblast NB3-1 (Drosophila)
def: "Neuroblast NB3-1 delaminates at S3 in the medial column of neuroblasts. It generates the well characterized RP1 (FBbt:00001452), RP3 (FBbt:00001455), RP4 (FBbt:00001456) and RP5 (FBbt:00001457) motorneurons and a cluster of intersegmental interneurons. It also generates a variable number of local of local interneurons (http://www.neuro.uoregon.edu/doelab/lineages/NB3-1.html). In the third instar larva, the lineage originated by this neuroblast is located near the midline." [FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB3-1.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/31%20description.html]
is_a: FBbt:00001393 ! stage 3 neuroblast (Drosophila)

[Term]
id: FBbt:00001395
name: neuroblast NB3-1 of thorax (Drosophila)
is_a: FBbt:00001394 ! neuroblast NB3-1 (Drosophila)
is_a: FBbt:00003561 ! thoracic neuroblast (Drosophila)
relationship: part_of FBbt:00005387 ! embryonic nervous system of thorax (Drosophila)

[Term]
id: FBbt:00001396
name: neuroblast NB3-1 of abdomen (Drosophila)
is_a: FBbt:00001394 ! neuroblast NB3-1 (Drosophila)
is_a: FBbt:00003584 ! abdominal neuroblast (Drosophila)
relationship: part_of FBbt:00005388 ! embryonic nervous system of abdomen (Drosophila)

[Term]
id: FBbt:00001397
name: neuroblast NB4-1 (Drosophila)
def: "Neuroblast NB4-1 delaminates at S3 in the medial column. It produces the putative motorneuron of the transverse nerve (FBbt:00001996) and a variety of intersegmental and local interneurons. In the third instar larva, the lineage originated by this neuroblast is located anteriorly in the medial region of the hemineuromere." [FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB4-1.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/41%20description.html]
is_a: FBbt:00001393 ! stage 3 neuroblast (Drosophila)

[Term]
id: FBbt:00001398
name: neuroblast NB6-1 (Drosophila)
def: "Neuroblast NB6-1 generates intersegmental and ~10-16 interneurons in every segment, but only generates a motorneuron in segment T1 (http://www.neuro.uoregon.edu/doelab/lineages/NB6-1.html). In the third instar larva, the lineage originated by this neuroblast is located lateral to the median lineage." [FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB6-1.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/61%20description.html]
is_a: FBbt:00001393 ! stage 3 neuroblast (Drosophila)

[Term]
id: FBbt:00001399
name: neuroblast NB6-4 (Drosophila)
def: "Neuroblast NB6-4 generates glia in abdominal segments as well as interneurons in thoracic segments." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB6-4.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/64%20description.html]
is_a: FBbt:00001393 ! stage 3 neuroblast (Drosophila)

[Term]
id: FBbt:00001400
name: neuroblast NB6-4 of thorax (Drosophila)
synonym: "NB6-4T" RELATED []
is_a: FBbt:00001399 ! neuroblast NB6-4 (Drosophila)
is_a: FBbt:00003561 ! thoracic neuroblast (Drosophila)
relationship: part_of FBbt:00005387 ! embryonic nervous system of thorax (Drosophila)

[Term]
id: FBbt:00001401
name: neuroblast NB6-4 of abdomen (Drosophila)
synonym: "NB6-4A" RELATED []
is_a: FBbt:00001399 ! neuroblast NB6-4 (Drosophila)
is_a: FBbt:00003584 ! abdominal neuroblast (Drosophila)
relationship: part_of FBbt:00005388 ! embryonic nervous system of abdomen (Drosophila)

[Term]
id: FBbt:00001402
name: neuroblast NB6-4a (Drosophila)
is_a: FBbt:00001401 ! neuroblast NB6-4 of abdomen (Drosophila)

[Term]
id: FBbt:00001403
name: neuroblast NB6-4b (Drosophila)
is_a: FBbt:00001401 ! neuroblast NB6-4 of abdomen (Drosophila)

[Term]
id: FBbt:00001404
name: neuroblast NB1-3 (Drosophila)
def: "Neuroblast located at the embryonic segment border close to the tracheal pit that produces only glial cells (Schmidt et al., 1997, Schmid et al., 1999)." [FlyBase:FBrf0098344, FlyBase:FBrf0112030]
is_a: CL:0000468 ! neuroglioblast (sensu Nematoda and Protostomia)
is_a: FBbt:00001393 ! stage 3 neuroblast (Drosophila)

[Term]
id: FBbt:00001405
name: neuroblast GP (Drosophila)
def: "Unlike the other neuroblasts, the glial precursor (GP) does not divide to make GMCs or neurons. Dividing roughly symmetrically during embryonic stage 11, it produces two cells that eventually divide to generate six longitudinal glia." [http://www.neuro.uoregon.edu/doelab/neuro/gp.html]
synonym: "glial precursor" EXACT [http://www.neuro.uoregon.edu/doelab/neuro/gp.html]
synonym: "Glioblast" EXACT [http://www.neuro.uoregon.edu/doelab/neuro/gp.html]
synonym: "GP" EXACT [http://www.neuro.uoregon.edu/doelab/neuro/gp.html]
is_a: FBbt:00001393 ! stage 3 neuroblast (Drosophila)

[Term]
id: FBbt:00001406
name: neuroblast GPa (Drosophila)
is_a: FBbt:00001405 ! neuroblast GP (Drosophila)

[Term]
id: FBbt:00001407
name: neuroblast GPb (Drosophila)
is_a: FBbt:00001405 ! neuroblast GP (Drosophila)

[Term]
id: FBbt:00001408
name: neuroblast X (Drosophila)
def: "Stage 3 neuroblast that expresses achaete (FBgn0000022)." [http://www.neuro.uoregon.edu/doelab/neuro/x.html]
is_a: FBbt:00001393 ! stage 3 neuroblast (Drosophila)

[Term]
id: FBbt:00001409
name: stage 4 neuroblast (Drosophila)
def: "A neuroblast delaminating in the fourth wave of neuroblast delamination from the ventral neurectoderm. This wave begins during embryonic stage 11, ending in late stage 11. The S4 neuroblasts delaminate into columns in between the existing intermediate and lateral columns of neuroblasts (Doe, 1992)." [FlyBase:FBrf0055900, FlyBase:FBrf0076117]
synonym: "S4 neuroblast" RELATED []
is_a: FBbt:00001369 ! neuroblast of ventral nerve cord primordium (Drosophila)

[Term]
id: FBbt:00001410
name: neuroblast NB2-1 (Drosophila)
def: "Neuroblast NB2-1 delaminates at S4 and generates approximately 9-15 local interneurons by embryonic stage 17. The fibers from these cells cross the midline via a single projection in a posterior fascicle of the anterior commissure (http://www.neuro.uoregon.edu/doelab/lineages/texts/21%20description.html). In the third instar larva, the lineage originated by this neuroblast is located near the midline on the anterior margin of the neuromere." [FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB2-1.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/21%20description.html]
is_a: FBbt:00001409 ! stage 4 neuroblast (Drosophila)

[Term]
id: FBbt:00001411
name: neuroblast NB2-4 (Drosophila)
def: "Neuroblast NB2-4 delaminates at S4 and generates a contralaterally projecting motorneuron and approximately 8 local interneurons." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB2-4.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/24%20description.html]
is_a: FBbt:00001409 ! stage 4 neuroblast (Drosophila)

[Term]
id: FBbt:00001412
name: neuroblast NB2-4 of thorax (Drosophila)
is_a: FBbt:00001411 ! neuroblast NB2-4 (Drosophila)
is_a: FBbt:00003561 ! thoracic neuroblast (Drosophila)
relationship: part_of FBbt:00005387 ! embryonic nervous system of thorax (Drosophila)

[Term]
id: FBbt:00001413
name: neuroblast NB2-4 of abdomen (Drosophila)
is_a: FBbt:00001411 ! neuroblast NB2-4 (Drosophila)
is_a: FBbt:00003584 ! abdominal neuroblast (Drosophila)
relationship: part_of FBbt:00005388 ! embryonic nervous system of abdomen (Drosophila)

[Term]
id: FBbt:00001414
name: neuroblast NB3-4 (Drosophila)
def: "Neuroblast NB3-4 delaminates at S5. It produces a single motorneuron located on the posterior boundary of the clone and projects into the anterior root of the ISN by embryonic stage 15. Along with several local interneurons, it also produces at least 2 intersegmental interneurons by embryonic stage 17, one extending ipsilaterally, the other crossing the anterior commissure before extending anteriorly (http://www.neuro.uoregon.edu/doelab/lineages/texts/34description.html)." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB3-4and4-4.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/34description.html]
is_a: FBbt:00001420 ! stage 5 neuroblast (Drosophila)

[Term]
id: FBbt:00001415
name: neuroblast NB4-4 (Drosophila)
def: "Neuroblast NB4-4 delaminates at S4. It generates a single motorneuron located at the posterior ventral boundary of the clone and projects into the anterior root of the ISN by stage 5. Amongst several local interneurons, it generates at least two intersegmental interneurons, one extending anterior ipsilaterally and the other crossing the anterior commissure (http://www.neuro.uoregon.edu/doelab/lineages/texts/44%20description.html)." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB3-4and4-4.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/44%20description.html]
is_a: FBbt:00001409 ! stage 4 neuroblast (Drosophila)

[Term]
id: FBbt:00001416
name: neuroblast NB5-4 (Drosophila)
def: "Neuroblast NB5-4 most frequently delaminates at S4 in an intermediate column. In the third instar larva, the lineage originated by this neuroblast is located at the ventro-lateral region of the neuromere." [FlyBase:FBrf0098344, FlyBase:FBrf0112030, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB5-4.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/54%20description.html]
is_a: CL:0000468 ! neuroglioblast (sensu Nematoda and Protostomia)
is_a: FBbt:00001409 ! stage 4 neuroblast (Drosophila)

[Term]
id: FBbt:00001417
name: neuroblast NB5-4 of thorax (Drosophila)
is_a: FBbt:00001416 ! neuroblast NB5-4 (Drosophila)
is_a: FBbt:00003561 ! thoracic neuroblast (Drosophila)
relationship: part_of FBbt:00005387 ! embryonic nervous system of thorax (Drosophila)

[Term]
id: FBbt:00001418
name: neuroblast NB5-4 of abdomen (Drosophila)
is_a: FBbt:00001416 ! neuroblast NB5-4 (Drosophila)
is_a: FBbt:00003584 ! abdominal neuroblast (Drosophila)
relationship: part_of FBbt:00005388 ! embryonic nervous system of abdomen (Drosophila)

[Term]
id: FBbt:00001419
name: neuroblast MNB (Drosophila)
def: "An unpaired neuroblast delaminating in stage 4 along the ventral midline of the CNS. It gives rise to a cluster of 5-8 cells with short bilateral projections in the anterior and posterior commissures and long fibers that enters the intersegmental nerve." [FlyBase:FBrf0072659, FlyBase:FBrf0112030]
synonym: "median neuroblast" EXACT [FlyBase:FBrf0072659]
is_a: FBbt:00001409 ! stage 4 neuroblast (Drosophila)

[Term]
id: FBbt:00001420
name: stage 5 neuroblast (Drosophila)
def: "A neuroblast delaminating in the fifth and final wave of neuroblast delamination from the ventral neurectoderm. This wave begins during embryonic in late stage 11. The S5 neuroblasts delaminate into columns in between the existing intermediate and lateral columns of neuroblasts (Doe, 1992)." [FlyBase:FBrf0055900, FlyBase:FBrf0076117]
synonym: "S5 neuroblast" RELATED []
is_a: FBbt:00001369 ! neuroblast of ventral nerve cord primordium (Drosophila)

[Term]
id: FBbt:00001421
name: neuroblast NB2-3 (Drosophila)
def: "Neuroblast NB2-3 delaminates at S5. It generates three large, round axonless cells at the dorsal side of the thoracic clones which are proposed by Schmid et al., (1999) to be latent leg motorneurons that will extend axons during leg disk eversion. It also generates 2-4 small interneurons at the ventral side of the clone. In the abdominal segments only a single large neuroblast is observed at embryonic stage 17, which either does not divide or all progeny die." [FlyBase:FBrf0084809, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB2-3.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/23%20description.html]
synonym: "NB1-2" RELATED [FlyBase:FBrf0055900]
is_a: FBbt:00001420 ! stage 5 neuroblast (Drosophila)

[Term]
id: FBbt:00001422
name: neuroblast NB3-3 (Drosophila)
def: "Neuroblast NB3-3 delaminates predominantly at S4 (Schmidt et al., 1997). It generates a single motorneuron positioned midway along the dorsoventral axis, though slightly lateral and posterior. It also generates 10-18 interneurons that project across the anterior commissure (Schmid et al., 1999). In the third instar larva, the lineage originated by this neuroblast is located at the ventro-lateral anterior half of the neuromere." [FlyBase:FBrf0098344, FlyBase:FBrf0180161, http://www.neuro.uoregon.edu/doelab/lineages/NB3-3.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/33description.html]
is_a: FBbt:00001409 ! stage 4 neuroblast (Drosophila)

[Term]
id: FBbt:00001423
name: neuroblast NB4-3 (Drosophila)
def: "Neuroblast NB4-3 delaminates at S5. It generates 2-3 neurosecretory cells that project together out of the CNS, appearing to join the transverse nerve in the periphery. In addition, 10-12 small, axonless interneurons are also produced at stage 17." [FlyBase:FBrf0098344, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB4-3.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/43%20description.html]
is_a: FBbt:00001420 ! stage 5 neuroblast (Drosophila)

[Term]
id: FBbt:00001424
name: neuroblast NB5-1 (Drosophila)
def: "Neuroblast NB5-1 delaminates at S5 in the medial column. It generates approximately 6-9 local interneurons that predominantly project across the posterior commissure (Schmid et al., 1999)." [FlyBase:FBrf0098344, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB5-1.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/51%20description.html]
is_a: FBbt:00001420 ! stage 5 neuroblast (Drosophila)

[Term]
id: FBbt:00001425
name: neuroblast NB5-5 (Drosophila)
def: "Neuroblast NB5-5 delaminates at S5. Thoracic and abdominal clones contain 8-11 large neurons including interneurons and neurosecretory cells." [FlyBase:FBrf0098344, FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB5-5.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/55%20description.html]
synonym: "clone Y" RELATED [FlyBase:FBrf0098344]
is_a: FBbt:00001420 ! stage 5 neuroblast (Drosophila)

[Term]
id: FBbt:00001426
name: neuroblast NB7-3 (Drosophila)
def: "Neuroblast NB7-3 delaminates at S5. It generates the relatively small GW motorneuron, positioned on the lateral side of the clone and projects out the posterior root of the ISN. It also generates three slightly larger interneurons that project across the posterior commissure, and a small axonless cell. It may also generate a glial cell (http://www.neuro.uoregon.edu/doelab/lineages/texts/73%20description.html)." [FlyBase:FBrf0112030, http://www.neuro.uoregon.edu/doelab/lineages/NB7-3.html, http://www.neuro.uoregon.edu/doelab/lineages/texts/73%20description.html]
is_a: FBbt:00001420 ! stage 5 neuroblast (Drosophila)

[Term]
id: FBbt:00001427
name: MP1 precursor (Drosophila)
def: "Unpaired precursor cell that divides to produce two MP1 interneurons." [FlyBase:FBrf0041721, FlyBase:FBrf0049007, FlyBase:FBrf0072659, FlyBase:FBrf0190277]
synonym: "midline precursor 1 neuron" EXACT [FlyBase:FBrf0041721, FlyBase:FBrf0072659]
synonym: "MP1 neurons" RELATED []
is_a: FBbt:00005565 ! ventral midline neuroblast (Drosophila)

[Term]
id: FBbt:00001428
name: VUM precursor (Drosophila)
def: "Midline precursor neuroblast of the ventral nerve cord located posteriorly to MP3 precursors. It gives rise to one motorneuron and one interneuron. There are 3 VUM precursors in each segment (MP4-6)." [FlyBase:FBrf0064795, FlyBase:FBrf0072659, FlyBase:FBrf0195284]
synonym: "Midline precursor 4 cell" EXACT [FlyBase:FBrf0195284]
synonym: "MP4 cell" EXACT [FlyBase:FBrf0195284]
synonym: "MP5 cell" EXACT [FlyBase:FBrf0195284]
synonym: "MP6 cell" EXACT [FlyBase:FBrf0195284]
is_a: FBbt:00005565 ! ventral midline neuroblast (Drosophila)

[Term]
id: FBbt:00001429
name: posterior VUM precursor (Drosophila)
is_a: FBbt:00001428 ! VUM precursor (Drosophila)

[Term]
id: FBbt:00001430
name: mid VUM precursor (Drosophila)
is_a: FBbt:00001428 ! VUM precursor (Drosophila)

[Term]
id: FBbt:00001431
name: anterior VUM precursor (Drosophila)
is_a: FBbt:00001428 ! VUM precursor (Drosophila)

[Term]
id: FBbt:00001432
name: MP3 precursor (Drosophila)
def: "Midline precursor neuron of the ventral nerve cord posterior to MP1 precursor. It divides once to give rise to the interneurons H-cell and the H-cell sib." [FlyBase:FBrf0072659, FlyBase:FBrf0190277, FlyBase:FBrf0195284]
synonym: "Midline precursor 3 cell" EXACT [FlyBase:FBrf0195284]
synonym: "MP3 cell" EXACT [FlyBase:FBrf0195284]
synonym: "UMI precursor" EXACT [FlyBase:FBrf0072659]
synonym: "unpaired median interneuron precursor" EXACT [FlyBase:FBrf0072659]
is_a: FBbt:00005565 ! ventral midline neuroblast (Drosophila)

