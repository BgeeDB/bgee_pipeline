is_a: FBbt:00003664 ! intrinsic neuron (Drosophila)
relationship: part_of FBbt:00007146 ! adult deutocerebrum (Drosophila)

[Term]
id: FBbt:00003989
name: bilateral intrinsic neuron (Drosophila)
def: "A midline crossing bilateral intrinsic neuron that projects only within some pair of bilaterally symmetric synaptic neuropil domains and their connecting tracts. For example within the left and right antennal lobes and antennal commissure." [FBC:DOS]
synonym: "bilateral local interneuron" RELATED []
is_a: FBbt:00003664 ! intrinsic neuron (Drosophila)

[Term]
id: FBbt:00003991
name: unilateral ACT relay interneuron (Drosophila)
def: "Unilateral antennal lobe projection neuron that projects from a single antennal lobe glomerulus to the mushroom body calyx and lateral horn via the medial antennal lobe tract." [FlyBase:FBrf0051437]
synonym: "uACTI" EXACT []
is_a: FBbt:00007383 ! uniglomerular antennal lobe projection neuron (Drosophila)
is_a: FBbt:00100227 ! mushroom body extrinsic neuron (Drosophila)

[Term]
id: FBbt:00003992
name: bilateral ACT relay interneuron (Drosophila)
def: "Bilateral antennal lobe projection neuron whose dendrites innervate a small number of glomeruli in both antennal lobes and whose axon fasciculates with the (medial?) antennal lobe tract and innervates the mushroom body calyx and the lateral horn." [FlyBase:FBrf0051437]
synonym: "bACTI" RELATED []
is_a: FBbt:00007441 ! adult multiglomerular antennal lobe projection neuron (Drosophila)

[Term]
id: FBbt:00003993
name: fine arborization relay interneuron (Drosophila)
def: "Antennal lobe projection neuron with fine dendritic arborization throughout the antennal lobe." [FlyBase:FBrf0051437]
synonym: "FAI" EXACT [FlyBrain_NDB:10364]
synonym: "FAI" RELATED []
is_a: FBbt:00007441 ! adult multiglomerular antennal lobe projection neuron (Drosophila)

[Term]
id: FBbt:00003994
name: giant symmetrical relay interneuron (Drosophila)
def: "A bilateral projection neuron of the adult antennal lobe with extensive dendritic arborization in both antennal lobes, extensive axonal arborizations in the posterior brain and a cell body situated in the midline of the subesophageal ganglion." [FlyBase:FBrf0051437]
synonym: "GSI" EXACT [FlyBrain_NDB:10365]
synonym: "GSI" RELATED []
is_a: FBbt:00007441 ! adult multiglomerular antennal lobe projection neuron (Drosophila)

[Term]
id: FBbt:00003995
name: bilateral V relay interneuron (Drosophila)
def: "Asymmetric relay interneuron that branches profusely in antennal lobe glomerulus V of the adult brain. It sends a posterior projection that branches once. The lateral branch extends into the ventro-lateral deutocerebrum. The posterior branch connects with the mirror-symmetric contralateral V-relay interneuron in the subesophageal zone, and, slightly lateral to the midline, this process extends into the lateral GRG." [FlyBase:FBrf0051437]
synonym: "bilateral V-relay interneuron" EXACT [FlyBase:FBrf0051437]
synonym: "bVI" EXACT [FlyBrain_NDB:10366]
is_a: FBbt:00067123 ! adult antennal lobe projection neuron (Drosophila)

[Term]
id: FBbt:00003996
name: thoracic relay interneuron (Drosophila)
def: "A unilateral interneuron with extensive arborization in one antennal lobe and the posterior brain, and a process that extends into the thorax." [FlyBase:FBrf0051437]
synonym: "TI" EXACT [FlyBrain_NDB:10367]
synonym: "TI" RELATED []
is_a: FBbt:00007441 ! adult multiglomerular antennal lobe projection neuron (Drosophila)

