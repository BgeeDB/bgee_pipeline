namespace: uberon
def: "." [PHENOSCAPE:alex]
is_a: UBERON:0004766 ! cranial bone
property_value: curator_notes "distinct from UBERON:0001694 petrous part of temporal bone; [PMID:19438763]" xsd:string

[Term]
id: UBERON:0018349
name: pharyngeal apophysis
namespace: uberon
def: "Ventral process on the neurocranium for the articulation of upper pharyngeal bones. It is variably composed of the parasphenoid, basioccipital, and prootic depending on the species. From: Greenwood, PH (1978). A review of the pharyngeal hypophysis and its significance in the classification of African cichlid fishes. Bull. Br. Mus. Nat. Hist. (Zool.) 33: 297-323." [PHENOSCAPE:Wasila]
synonym: "neurocranium apophysis" EXACT [PHENOSCAPE:Wasila]
