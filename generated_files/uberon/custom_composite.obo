relationship: develops_from CL:0000333 ! migratory neural crest cell
relationship: part_of UBERON:0001747 ! parenchyma of thyroid gland

[Term]
id: CL:0000571
name: leucophore
namespace: cell
def: "A pigment cell derived from the neural crest. Contains uric acid or other purine crystals deposited in stacks called leucosomes. The crystals reflect light and this gives a white appearance under white light." []
is_a: CL:0000147 ! pigment cell
