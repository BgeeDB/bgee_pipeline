synonym: "adult tracheal cell" RELATED []
is_a: FBbt:00005038 ! tracheocyte (Drosophila)
relationship: part_of UBERON:0007023 ! adult organism

[Term]
id: FBbt:00005041
name: tracheal precursor cell (Drosophila)
def: "Somatic cell that gives rise to a tracheoblast. At embryonic stage 10 the tracheal precursor cells form ectodermal placodes that invaginate to form the tracheal pits by early stage 11." [FlyBase:FBrf0064787]
is_a: FBbt:00007008 ! somatic precursor cell (Drosophila)
relationship: part_of UBERON:0005155 ! open tracheal system

[Term]
id: FBbt:00005042
name: imaginal tracheoblast (Drosophila)
def: "Precursor cell of the adult tracheal branches, found in the embryo or larva. Imaginal tracheoblasts originate from the spiracular branches in tracheal metamere 2 to 9, near the junctions with the transverse connectives and from several scattered positions in tracheal metameres 1 and 2." [FlyBase:FBrf0064787, FlyBase:FBrf0064803]
synonym: "tracheal histoblast" EXACT [FlyBase:FBrf0054028]
is_a: FBbt:00005605 ! imaginal tracheal precursor (Drosophila)
is_a: UBERON:0004121 ! ectoderm-derived structure
relationship: develops_from FBbt:00005041 ! tracheal precursor cell (Drosophila)
relationship: develops_from UBERON:6005036 ! tracheal pit

[Term]
id: FBbt:00005044
name: mestracheon (Drosophila)
def: "Membrane that surrounds some tracheoles, separating them from the cytoplasm of the surrounding tracheolar cell." [FlyBase:FBrf0088947]
is_a: FBbt:00007012 ! cell component (Drosophila)
relationship: part_of FBbt:00005048 ! tracheolar cell (Drosophila)

[Term]
id: FBbt:00005045
name: taenidium (Drosophila)
def: "A thread-like cuticular substructure that runs along the length a taenidial fold, just below the surface of the tracheal lumen." [FlyBase:FBrf0064787]
synonym: "taenidia" EXACT []
relationship: part_of FBbt:00005046 ! taenidial fold (Drosophila)

[Term]
id: FBbt:00005046
name: taenidial fold (Drosophila)
def: "A specialization of the cuticular lining of the trachea consisting of annular or helical ridges that project into the tracheal lumen (their precise pattern varies along trachea). They prevent the collapse of branches while allowing them to expand and contract along their length, like the corrugated hose of a vacuum cleaner." [FlyBase:FBrf0064787]
is_a: UBERON:6007245 ! cuticular specialization
relationship: part_of UBERON:0003127 ! open tracheal system trachea

[Term]
id: FBbt:00005047
name: tracheole (Drosophila)
def: "Terminal branch of the tracheal system. Tracheoles consist of fine cuticular tubes (around 1 micrometre in diameter or less) that extend from individual tracheolar cells. Tracheoles lack a mestracheon." [FlyBase:FBrf0064787, FlyBase:FBrf0087684, FlyBase:FBrf0088947]
is_a: FBbt:00007012 ! cell component (Drosophila)
relationship: part_of FBbt:00005048 ! tracheolar cell (Drosophila)

[Term]
id: FBbt:00005048
name: tracheolar cell (Drosophila)
def: "Specialized cell of the tracheal system that forms the secondary and terminal branches (tracheoles) of the tracheal tree. Each forms a secondary branch of a primary trachea. This secondary branch itself branches into multiple tracheoles within fine cytoplasmic projections that invade (tracheate) target tissues. Tracheolar cells are the main site of respiratory gaseous exchange within the tracheal system." [FlyBase:FBrf0064787, FlyBase:FBrf0088947]
synonym: "tracheal end cell" EXACT [FlyBase:FBrf0064787]
synonym: "tracheoblast" EXACT [FlyBase:FBrf0064787]
is_a: FBbt:00100318 ! somatic cell (Drosophila)
relationship: develops_from FBbt:00005053 ! terminal tracheal cell (Drosophila)
relationship: part_of UBERON:0005155 ! open tracheal system

[Term]
id: FBbt:00005049
name: tracheal node (Drosophila)
def: "Part of the tracheal system where 2 tracheal metameres are connected by a tracheal fusion. Tracheal nodes have a distinctive cuticular lining and are populated by tracheal node cells." [FlyBase:FBrf0064787]
synonym: "tracheal anastomosis" EXACT []
is_a: UBERON:0003127 ! open tracheal system trachea

[Term]
id: FBbt:00005050
name: tracheal node cell (Drosophila)
def: "Specialized tracheocyte found at tracheal nodes. These cells play a critical role in fragmentation of the tracheal cuticle during moults and in remodelling of the tracheal epithelium during metamorphosis." [FlyBase:FBrf0064787]
is_a: CL:0008026 ! open tracheal system tracheocyte
is_a: FBbt:00005038 ! tracheocyte (Drosophila)
relationship: develops_from FBbt:00005052 ! tracheal fusion cell (Drosophila)
relationship: part_of FBbt:00005049 ! tracheal node (Drosophila)

[Term]
id: FBbt:00005051
name: tracheal tip cell (Drosophila)
def: "Cell at the tip of a developing trachea." [FBC:DOS]
synonym: "pantip cell" EXACT [FlyBase:FBrf0087684]
is_a: FBbt:00007008 ! somatic precursor cell (Drosophila)

[Term]
id: FBbt:00005052
name: tracheal fusion cell (Drosophila)
def: "Tracheal tip cell that mediates the fusion of tracheal branches during embryogenesis and later develops into a node cell." [FlyBase:FBrf0064787]
synonym: "homotip tracheal tip cell" RELATED [FlyBase:FBrf0064787]
is_a: FBbt:00005051 ! tracheal tip cell (Drosophila)

[Term]
id: FBbt:00005053
name: terminal tracheal cell (Drosophila)
def: "Tracheal tip cell that does not fuse with other trachea, but instead develops into a tracheolar cell - forming secondary trachea and tracheoles." [FlyBase:FBrf0064787]
synonym: "heterotip tracheal tip cell" RELATED [FlyBase:FBrf0064787]
is_a: FBbt:00005051 ! tracheal tip cell (Drosophila)
relationship: part_of FBbt:00017025 ! secondary branch/tracheole primordium (Drosophila)

[Term]
id: FBbt:00005064
name: melanotic mass (Drosophila)
synonym: "melanotic tumor" RELATED []
synonym: "pseudotumor" RELATED []
relationship: develops_from CL:0000387 ! hemocyte (sensu Nematoda and Protostomia)
relationship: part_of UBERON:0001009 ! circulatory system

[Term]
id: FBbt:00005065
name: adipose system (Drosophila)
def: "The system of organs and cells involved in fat storage." [FBC:gg]
is_a: UBERON:0000467 ! anatomical system

[Term]
id: FBbt:00005067
name: fat body primordium (Drosophila)
def: "The fat body primordium after the gonadal sheath primordium splits from it during stage 14. During late embryogenesis, various holes and clefts form, giving the fat body its larval form. The cells of this primordium do not accumulate fat during their differentiation (this only happens in the larval fat body)." [FlyBase:FBrf0089570]
synonym: "fat body specific anlage" RELATED []
is_a: UBERON:0001048 ! primordium
is_a: UBERON:6026002 ! visceral mesoderm derivative
relationship: develops_from FBbt:00005520 ! fat body/gonad primordium (Drosophila)

[Term]
id: FBbt:00005070
name: visceral muscle (Drosophila)
def: "The visceral musculature comprises circular and longitudinal fibers which surround the entire intestinal tract, with the exception of the recurrent layer of the proventriculus. The circular fibers derive from a bilaterally symmetrical band of mesodermal cells extending continuously throughout most of the germ band. The longitudinal fibers derive from clusters of mesodermal cells which appear during stage 12 at the posterior end of the embryo and migrate anteriorly." [FlyBase:FBrf0064793, FlyBase:FBrf0089570]
is_a: CL:0000187 ! muscle cell
relationship: part_of UBERON:0000383 ! musculature of body

[Term]
id: FBbt:00005071
name: longitudinal visceral muscle fiber (Drosophila)
synonym: "longitudinal visceral muscle fibers" EXACT []
is_a: FBbt:00005075 ! muscle fiber (Drosophila)
relationship: part_of FBbt:00000480 ! longitudinal muscle (Drosophila)

[Term]
id: FBbt:00005072
name: circular visceral muscle fiber (Drosophila)
synonym: "circular visceral muscle fibers" EXACT []
is_a: FBbt:00005075 ! muscle fiber (Drosophila)
relationship: develops_from FBbt:00017015 ! circular visceral muscle primordium (Drosophila)

[Term]
id: FBbt:00005075
name: muscle fiber (Drosophila)
is_a: FBbt:00005070 ! visceral muscle (Drosophila)

