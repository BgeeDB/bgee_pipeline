xref: EFO:0002471
xref: FMA:271593
xref: Posterior:cingulate
relationship: part_of UBERON:0003027 {source="NIFSTD"} ! cingulate cortex
property_value: editor_note "check relationship to gyrus. See https://github.com/obophenotype/uberon/issues/626" xsd:string

