is_a: UBERON:0002616 ! regional part of brain
relationship: part_of UBERON:6001920 ! insect embryonic/larval brain

[Term]
id: FBbt:00100139
name: embryonic/larval subesophageal ganglion area 1 (Drosophila)
def: "Chemosensory neuron target area located at the midline of the larval subesophageal ganglion (SOG). This area receives input from pharyngeal chemosensory neurons (the dorsal pharyngeal sense organ, the dorsal pharyngeal organ, and the posterior pharyngeal sense organ) (Colomb et al., 2007)." [FlyBase:FBrf0167539, FlyBase:FBrf0201176, FlyBase:FBrf0201188]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00100138 ! embryonic/larval subesophageal ganglion (Drosophila)

[Term]
id: FBbt:00100140
name: embryonic/larval subesophageal ganglion area 2 (Drosophila)
def: "Large chemosensory target area located adjacent to area 1 of the larval subesophageal ganglion. This region receives input from the dorsal pharyngeal sense organ, the ventral pharyngeal sense organ, the posterior pharyngeal sense organ, the dorsal pharyngeal organ, the terminal organ, and the ventral pharyngeal sense organ (Colomb et al., 2007)." [FlyBase:FBrf0167539, FlyBase:FBrf0201176, FlyBase:FBrf0201188]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00100138 ! embryonic/larval subesophageal ganglion (Drosophila)

[Term]
id: FBbt:00100141
name: embryonic/larval subesophageal ganglion area 3 (Drosophila)
def: "Small chemosensory target area located laterally in the larval subesophageal ganglion. This region receives input from non-olfactory neurons of the dorsal organ and from thoracic projections originating in the Kolbchen (also called the 'ventral pit'; Colomb et al., 2007)." [FlyBase:FBrf0167539, FlyBase:FBrf0201176, FlyBase:FBrf0201188]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00100138 ! embryonic/larval subesophageal ganglion (Drosophila)

[Term]
id: FBbt:00100142
name: embryonic/larval subesophageal ganglion area 4 (Drosophila)
def: "Large chemosensory target area of the larval subesophageal ganglion, located adjacent to the antennal lobes. One or a few neurites from dorsal pharyngeal sense organ neuron(s), and an atypical dorsal organ neuron whose dendrites extend into the terminal organ, target this region (Colomb et al., 2007)." [FlyBase:FBrf0167539, FlyBase:FBrf0201176, FlyBase:FBrf0201188]
is_a: FBbt:00040006 ! synaptic neuropil subdomain (Drosophila)
relationship: part_of FBbt:00100138 ! embryonic/larval subesophageal ganglion (Drosophila)

