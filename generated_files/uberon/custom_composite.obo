is_a: CL:0000164 ! enteroendocrine cell
is_a: CL:0000170 ! glucagon secreting cell
created_by: tmeehan
creation_date: 2010-09-10T10:48:54Z

[Term]
id: CL:0002068
name: Purkinje myocyte
namespace: cell
def: "Specialized cardiac myocyte that is subendocardially interspersed with the regular cardiac muscle cell. They are uninucleate cylindrical cells, associated end-to-end in long rows, continue from the node to the atrioventricular bundle; relatively short compared to ordinary myocytes but are nearly twice their diameter." []
synonym: "myocytus conducens cardiacus" EXACT []
synonym: "Purkinje cell fiber" EXACT []
synonym: "Purkinje muscle cell" EXACT []
