[Term]
id: UBERON:0010750
name: prefrontal bone
namespace: uberon
def: "A bone separating the lacrimal and frontal bones in many tetrapod skulls" [http://en.wikipedia.org/wiki/Prefrontal_bone]
synonym: "prefrontal" BROAD [AAO:0000460]
