is_a: CL:0000842 ! mononuclear cell
is_a: CL:0011115 ! precursor cell
is_a: UBERON:0004120 ! mesoderm-derived structure
relationship: develops_from CL:0000559 ! promonocyte

[Term]
id: CL:0000577
name: type EC enteroendocrine cell
namespace: cell
alt_id: CL:0002065
def: "A subtype of enteroendocrine cells found in the gastrointestinal mucosa, particularly in the glands of pyloric antrum; duodenum; and ileum. These cell type secretes serotonin and some neurotransmitters including enkephalins and substance P. Their secretory granules stain readily with silver (argentaffin stain)." []
synonym: "argentaffin cell" EXACT []
synonym: "enterochromaffin cell" EXACT []
synonym: "Kulchitsky cell" EXACT []
