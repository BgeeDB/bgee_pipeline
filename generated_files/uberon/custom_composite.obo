is_a: FBbt:00005783 ! midgut interstitial cell (Drosophila)
relationship: develops_from FBbt:00000446 ! interstitial cell precursor (Drosophila)
relationship: part_of FBbt:00001884 ! mid embryonic/larval midgut (Drosophila)

[Term]
id: FBbt:00001889
name: iron accumulating cell (Drosophila)
def: "A cell type of the posterior-most region of the middle midgut of the larva that accumulates iron when this is present at low concentrations in the food (1ug/g of ferric ferrocyanide (Prussian blue))." [FlyBase:FBrf0008422]
is_a: FBbt:00001886 ! embryonic/larval midgut cell (Drosophila)
relationship: part_of FBbt:00001884 ! mid embryonic/larval midgut (Drosophila)

