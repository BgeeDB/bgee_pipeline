def: "Circulatory cell of the embryonic/larval hemolymph that is involved in the cellular immune response." [FlyBase:FBrf0037631]
synonym: "embryonic/larval blood cell" EXACT []
synonym: "embryonic/larval haemocyte" EXACT []
