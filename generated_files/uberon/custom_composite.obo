[Term]
id: CL:0002072
name: nodal myocyte
namespace: cell
def: "A specialized cardiac myocyte in the sinoatrial and atrioventricular nodes. The cell is slender and fusiform confined to the nodal center, circumferentially arranged around the nodal artery." []
synonym: "cardiac pacemaker cell" EXACT []
