synonym: "carpal bones" EXACT [EMAPA:25056, FMA:71335]
synonym: "carpal bones set" EXACT [FMA:71335]
synonym: "carpus" RELATED [MA:0000040, XAO:0003207]
synonym: "fore mesopodial skeleton" EXACT []
synonym: "fore mesopodium" RELATED [AAO:0000201]
synonym: "fore mesopodium skeleton" EXACT []
synonym: "ossa carpi" EXACT []
synonym: "ossa carpi" RELATED LATIN [http://en.wikipedia.org/wiki/Carpus]
