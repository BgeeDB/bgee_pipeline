relationship: develops_from XAO:0000320 ! sensorial layer (Xenopus)

[Term]
id: XAO:0000069
name: ventral marginal zone (Xenopus)
def: "Embryonic tissue region that will make the ventral mesoderm." [XAO:EJS]
synonym: "VMZ" EXACT []
is_a: UBERON:0004879 ! marginal zone of embryo

[Term]
id: XAO:0000070
name: ventro-lateral marginal zone (Xenopus)
def: "Region of the marginal zone extending from the ventral to lateral surface." [XAO:EJS]
is_a: UBERON:0004879 ! marginal zone of embryo

[Term]
id: XAO:0000071
name: dorso-lateral marginal zone (Xenopus)
def: "Region of the marginal zone extending from the dorsal to lateral surface." [XAO:EJS]
is_a: UBERON:0004879 ! marginal zone of embryo

[Term]
id: XAO:0000074
name: involuting marginal zone (Xenopus)
def: "Portion of the marginal zone of the embryo that turns inside the embryo during involution." [WEB:worms.zoology.wisc.edu/frogs/glossary.html]
synonym: "IMZ" EXACT []
is_a: UBERON:0004879 ! marginal zone of embryo

[Term]
id: XAO:0000075
name: involuting marginal zone mesenchymal layer (Xenopus)
def: "Deep layers of the IMZ consisting of prospective migrating mesodermal cells (which will migrate into the interior and form the leading edge of the mesodermal mantle) and prospective converging and extending mesoderm." [ISBN:0123646200]
synonym: "deep involuting marginal zone" RELATED []
is_a: UBERON:0005291 ! embryonic tissue
relationship: part_of XAO:0000074 ! involuting marginal zone (Xenopus)

[Term]
id: XAO:0000076
name: involuting marginal zone epithelial layer (Xenopus)
def: "Layer of prospective endoderm in the IMZ that will form the roof of the archenteron." [ISBN:0123646200]
synonym: "superficial involuting marginal zone" RELATED []
is_a: UBERON:0005291 ! embryonic tissue
relationship: part_of XAO:0000074 ! involuting marginal zone (Xenopus)

[Term]
id: XAO:0000077
name: bottle cell (Xenopus)
def: "Cell type that is first to migrate inwards at the blastopore during gastrulation." [OMD:bottle+cell]
is_a: XAO:0003244 ! gastrula cell (Xenopus)

[Term]
id: XAO:0000078
name: blastopore lip (Xenopus)
def: "The edge of the blastopore. Local invagination is caused by narrowing of bottle cells at the exterior edge of the blastula." [ISBN:0387537406]
relationship: part_of UBERON:0000100 ! blastopore

[Term]
id: XAO:0000080
name: forelimb region (Xenopus)
def: "The region from which the forelimb develops, first recognizable at NF stage 48, and distinct by NF stage 49." [XAO:curators]
synonym: "fore limb region" EXACT []
is_a: XAO:0003186 ! anatomical region (Xenopus)

[Term]
id: XAO:0000081
name: hindlimb region (Xenopus)
def: "The region from which the hindlimb develops, first recognizable as a slight concentration of mesenchymal cells dorsal and lateral to the anal tube at NF stage 43. The epidermal layers thicken dramatically through to NF stage 48, and become vascularised by NF stage 49." [XAO:curators]
synonym: "hind limb region" EXACT []
is_a: XAO:0003186 ! anatomical region (Xenopus)

[Term]
id: XAO:0000082
name: circumblastoporal collar (Xenopus)
def: "Embryonic structure that develops around the closed blastopore." [PMID:22138030]
synonym: "circumblastoporal region" RELATED []
is_a: UBERON:0002050 ! embryonic structure
is_a: UBERON:0004120 ! mesoderm-derived structure

[Term]
id: XAO:0000083
name: involuted dorsal mesoderm (Xenopus)
def: "Dorsal mesoderm that has grown and curled inward during gastrulation." [WEB:medical-dictionary.thefreedictionary.com/involution]
is_a: UBERON:0005291 ! embryonic tissue
relationship: part_of XAO:0000082 ! circumblastoporal collar (Xenopus)

[Term]
id: XAO:0000084
name: involuted ventral mesoderm (Xenopus)
def: "Ventral mesoderm that has grown and curled inward during gastrulation." [WEB:medical-dictionary.thefreedictionary.com/involution]
is_a: UBERON:0005291 ! embryonic tissue
relationship: part_of XAO:0000082 ! circumblastoporal collar (Xenopus)

[Term]
id: XAO:0000088
name: upper blastopore lip (Xenopus)
def: "Dorsal part of the blastopore lip, which forms as a result of the contraction of bottle cells." [XAO:EJS]
synonym: "dorsal blastopore lip" RELATED []
synonym: "organizer" BROAD []
synonym: "Spemann organizer" BROAD []
